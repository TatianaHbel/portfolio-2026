---
import CustomCursor from '../components/CustomCursor.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "I'm Tatiana, a product builder who loves bringing ideas to life with design + code.",
  ogImage = '/images/og-image.png',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;

// Page label shown in loader for non-home pages (e.g. "About — Tatiana" → "About")
const isHome = Astro.url.pathname === '/';
const pageLabel = isHome ? '' : title.split(/\s[—–|]\s/)[0].trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafcfd" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tatiana Hernandez" />
    <meta name="creator" content="Tatiana Hernandez" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content="Tatiana Hernandez | Product Designer & Engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" href="/images/favicon.ico" sizes="16x16" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/images/favicon.ico" sizes="180x180" />

    <!-- Font preloads (critical fonts only) -->
    <link rel="preload" href="/fonts/crimson-pro-latin.woff2" as="font" crossorigin="" type="font/woff2" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" crossorigin="" type="font/woff2" />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" crossorigin="" type="font/woff2" />
    <link rel="preload" href="/fonts/tiempos-text-italic.otf" as="font" crossorigin="" type="font/otf" />
    <link rel="preload" href="/fonts/crimson-pro-italic-latin.woff2" as="font" crossorigin="" type="font/woff2" />
    <link rel="preload" href="/fonts/tiempos-text-regular.otf" as="font" crossorigin="" type="font/otf" />
  </head>

  <body class="antialiased font-geist-sans">

    <!-- ── Loading screen ──────────────────────────────────────── -->
    <!-- data-home / data-label passed to JS for session logic -->
    <div id="loader" data-home={isHome ? '1' : ''} data-label={pageLabel}>
      <div id="loader-screen">
        <!-- Greetings (home first-visit only) -->
        <div id="loader-greetings">
          <span>Hola</span>
          <span>Hello</span>
          <span>Salut</span>
          <span>Bonjour</span>
          <span>Ciao</span>
          <span>Hallo</span>
        </div>
        <!-- Section label (all other pages) -->
        <div id="loader-label"></div>
        <!-- Circular arc — hangs below screen, creates curved exit edge -->
        <div class="loader-arc">
          <div class="loader-arc-inner"></div>
        </div>
      </div>
    </div>

    <CustomCursor />

    <div class="flex h-[100dvh] overflow-hidden">
      <div class="flex-1 transition-all duration-200 ease-in-out overflow-y-auto">
        <div class="min-h-screen flex flex-col">
          <Header />
          <main class="flex-1">
            <slot />
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </body>

<style>
  /* ── Loading screen ───────────────────────────────────── */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    /* no overflow:hidden — lets the circular arc extend below viewport */
  }

  #loader-screen {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 100vh;
    background: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;  /* arc hangs below */
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
  }
  #loader-screen.exit {
    /* Extra clearance so the arc (180px below screen bottom) fully exits */
    transform: translateY(calc(-100% - 200px));
  }

  /* Greetings container — relative so spans can stack inside it */
  #loader-greetings {
    position: relative;
    width: 100%;
    height: clamp(3rem, 9vw, 7.5rem);
  }
  #loader-greetings span {
    font-family: var(--font-tiempos-text);
    font-size: clamp(2.5rem, 8vw, 6rem);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  #loader-greetings span.active { opacity: 1; }

  /* Label — plain flex child, centered by parent flex container */
  #loader-label {
    font-family: var(--font-tiempos-text);
    font-size: clamp(2.5rem, 8vw, 6rem);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #loader-label.active { opacity: 1; }

  /* ── Circular arc — true ellipse for organic exit curve ── */
  /* Hangs 80px below the bottom of loader-screen.
     overflow:hidden on the wrapper clips the ellipse to show
     only its bottom arc → convex-downward curve as it slides up. */
  .loader-arc {
    position: absolute;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 120vw;
    height: 100px;
    overflow: hidden;
    pointer-events: none;
  }
  .loader-arc-inner {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 300px;         /* tall ellipse = gradual, natural arc */
    background: var(--color-foreground);
    border-radius: 50%;
  }
</style>

<script>
  (function () {
    const loader    = document.getElementById('loader') as HTMLElement;
    const screen    = document.getElementById('loader-screen') as HTMLElement;
    const greetings = document.getElementById('loader-greetings') as HTMLElement;
    const labelEl   = document.getElementById('loader-label') as HTMLElement;
    const spans     = Array.from(greetings.querySelectorAll<HTMLElement>('span'));

    const isHome  = loader.dataset.home === '1';
    const label   = loader.dataset.label ?? '';
    const SEEN_KEY = 'tati-loader-seen';

    const slideUp = () => {
      screen.classList.add('exit');
      screen.addEventListener('transitionend', () => {
        loader.style.display = 'none';
      }, { once: true });
    };

    // Home, first visit in session → full greeting cycle
    if (isHome && !sessionStorage.getItem(SEEN_KEY)) {
      sessionStorage.setItem(SEEN_KEY, '1');
      greetings.style.display = 'block';
      labelEl.style.display   = 'none';

      const WORD_MS = 260, GAP_MS = 60;
      let i = 0;
      spans[0].classList.add('active');

      const cycle = setInterval(() => {
        spans[i].classList.remove('active');
        i++;
        if (i < spans.length) {
          spans[i].classList.add('active');
        } else {
          clearInterval(cycle);
          setTimeout(slideUp, 300);
        }
      }, WORD_MS + GAP_MS);

    // All other pages (or home return visits) → section label + quick slide
    } else {
      greetings.style.display = 'none';
      labelEl.style.display   = 'block';
      labelEl.textContent     = label || 'Work';

      // Tiny delay so the label renders before fade-in triggers
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          labelEl.classList.add('active');
          setTimeout(slideUp, 500);
        });
      });
    }
  })();
</script>

</html>
