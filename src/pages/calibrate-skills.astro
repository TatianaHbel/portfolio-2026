---
import '../styles/fonts.css';
import '../styles/theme.css';

const skills = [
  { label: 'Product Design',              x: 0.51, y: 0.12, sr: -3,  sd: 0,   er: -1.5 },
  { label: 'AI-native Product Design',    x: 0.68, y: 0.25, sr:  5,  sd: 40,  er:  2.0 },
  { label: 'Design Systems',              x: 0.33, y: 0.22, sr:  9,  sd: 80,  er:  2.5 },
  { label: 'User Research',               x: 0.24, y: 0.38, sr: -9,  sd: 120, er: -2.0 },
  { label: 'User Interface Design',       x: 0.74, y: 0.38, sr:  7,  sd: 60,  er:  1.5 },
  { label: 'Prototyping and Wireframing', x: 0.30, y: 0.79, sr:  3,  sd: 100, er:  1.0 },
  { label: 'Blockchain Experience',       x: 0.79, y: 0.53, sr: -7,  sd: 20,  er: -2.5 },
  { label: 'Generative AI',              x: 0.58, y: 0.82, sr: -4,  sd: 140, er: -1.5 },
  { label: 'Visual Design',              x: 0.72, y: 0.70, sr:  8,  sd: 160, er:  2.0 },
  { label: 'Creativity and Curiosity',   x: 0.21, y: 0.56, sr: -12, sd: 180, er: -3.0 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Skills Calibrator</title>
  <style>
    /* Dev tool: restore cursor hidden by base.css */
    * { cursor: auto !important; }
    .skill-badge { cursor: grab !important; }
    .skill-badge.dragging { cursor: grabbing !important; }

    html, body {
      min-height: 100vh;
      background: var(--color-background, #FAF8F5);
      margin: 0;
      padding: 0;
    }

    /* ── Dev label ─────────────────────────── */
    .cal-label {
      position: fixed;
      top: 16px;
      left: 20px;
      z-index: 100;
      font-family: var(--font-geist-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-primary);
      opacity: 0.6;
    }

    /* ── Orbit wrap ────────────────────────── */
    .orbit-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 24px;
    }

    /* Exact same orbit as about.astro desktop */
    #orbit {
      position: relative;
      width: 100%;
      max-width: 1200px;
      height: 680px;
    }

    /* ── Center block ──────────────────────── */
    .skills-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      z-index: 2;
      pointer-events: none;
      max-width: 520px;
    }

    .skills-icon {
      width: 104px;
      height: 104px;
      background: var(--color-primary, #ED7752);
      border-radius: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      margin: 0 auto 1.75rem;
    }

    .skills-heading {
      font-family: var(--font-tiempos-text, serif);
      font-style: italic;
      font-size: clamp(2.6rem, 5vw, 4.2rem);
      letter-spacing: -0.02em;
      line-height: 1.05;
      color: var(--color-foreground, #2E3141);
      margin-bottom: 1.25rem;
      white-space: nowrap;
    }

    .skills-sub {
      font-family: var(--font-geist-sans, sans-serif);
      font-size: clamp(0.875rem, 1.2vw, 1rem);
      color: var(--color-foreground, #2E3141);
      opacity: 0.5;
      line-height: 1.65;
    }

    /* ── Badges — identical to .skill-badge, visible + draggable ── */
    .skill-badge {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      background: rgba(237, 119, 82, 0.07);
      border: 1px solid rgba(237, 119, 82, 0.2);
      border-radius: 70px;
      font-family: var(--font-geist-sans, sans-serif);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--color-foreground, #2E3141);
      white-space: nowrap;
      /* Positioning */
      position: absolute;
      transform: translate(-50%, -50%);
      /* Drag */
      user-select: none;
      touch-action: none;
      z-index: 10;
      transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
    }

    .skill-badge:hover {
      border-color: rgba(237, 119, 82, 0.5);
      background: rgba(237, 119, 82, 0.12);
    }

    .skill-badge.dragging {
      border-color: var(--color-primary, #ED7752);
      background: rgba(237, 119, 82, 0.15);
      box-shadow: 0 4px 20px rgba(237, 119, 82, 0.22);
      z-index: 20;
    }

    .skill-badge.active {
      border-color: rgba(237, 119, 82, 0.55);
    }

    /* Coordinate hint floating below each badge */
    .xy-hint {
      position: absolute;
      top: calc(100% + 5px);
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-geist-mono, monospace);
      font-size: 9px;
      color: var(--color-primary, #ED7752);
      white-space: nowrap;
      opacity: 0.7;
      pointer-events: none;
    }

    /* ── HUD panel ─────────────────────────── */
    .hud {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 50;
      width: 272px;
      background: #fff;
      border: 1px solid rgba(46, 49, 65, 0.10);
      border-radius: 14px;
      box-shadow: 0 8px 32px rgba(46, 49, 65, 0.14);
      overflow: hidden;
    }

    .hud-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      border-bottom: 1px solid rgba(46, 49, 65, 0.07);
    }

    .hud-title {
      font-family: var(--font-geist-mono, monospace);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #8B8796;
    }

    .hud-copy {
      padding: 5px 12px;
      border-radius: 7px;
      border: none;
      background: var(--color-primary, #ED7752);
      color: #fff;
      font-family: var(--font-geist-mono, monospace);
      font-size: 10px;
      letter-spacing: 0.05em;
      transition: background 0.15s;
    }
    .hud-copy:hover { background: #C95E38; }

    .hud-list {
      padding: 4px 0;
      max-height: 252px;
      overflow-y: auto;
    }

    .hud-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 14px;
      gap: 8px;
      transition: background 0.1s;
    }
    .hud-row:hover  { background: rgba(237, 119, 82, 0.05); }
    .hud-row.active { background: rgba(237, 119, 82, 0.09); }

    .hud-name {
      font-family: var(--font-geist-sans, sans-serif);
      font-size: 11px;
      color: #2E3141;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hud-xy {
      font-family: var(--font-geist-mono, monospace);
      font-size: 10px;
      color: var(--color-primary, #ED7752);
      flex-shrink: 0;
      font-variant-numeric: tabular-nums;
    }

    .hud-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
      border-top: 1px solid rgba(46, 49, 65, 0.07);
    }

    .hud-reset {
      font-family: var(--font-geist-mono, monospace);
      font-size: 10px;
      color: #8B8796;
      background: none;
      border: none;
      padding: 3px 8px;
      border-radius: 5px;
      transition: background 0.15s, color 0.15s;
    }
    .hud-reset:hover { background: rgba(46, 49, 65, 0.06); color: #2E3141; }

    .copy-ok {
      font-family: var(--font-geist-mono, monospace);
      font-size: 10px;
      color: #4caf50;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .copy-ok.show { opacity: 1; }
  </style>
</head>
<body>

  <span class="cal-label">Calibrate</span>

  <!-- Orbit — same structure as about.astro section 2 -->
  <div class="orbit-wrap">
    <div id="orbit">

      <div class="skills-center">
        <div class="skills-icon">
          <svg width="44" height="44" viewBox="0 0 351 350" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M267.839 0.520205C233.1 6.1852 194.47 41.9362 173.223 88.0852C170.691 93.5852 168.071 99.7732 167.402 101.835C166.732 103.898 165.834 105.585 165.407 105.585C164.98 105.585 161.33 100.123 157.297 93.4482C141.701 67.6332 126.333 51.4142 108.263 41.6982C64.9113 18.3882 27.6283 27.5692 9.23233 66.0852C-8.63167 103.488 -0.328674 154.972 32.0333 207.464C47.7003 232.875 67.7053 258.726 84.3643 275.085C89.9653 280.585 99.2763 290.485 105.056 297.085C120.719 314.972 133.749 326.262 151.566 337.387C176.316 352.84 189.097 353.169 209.216 338.873C240.057 316.958 302.071 235.971 327.359 184.585C336.825 165.349 340.462 154.251 345.991 127.741C352.102 98.4362 351.705 71.0232 344.866 50.0712C336.992 25.9492 320.94 9.71121 298.037 2.70021C290.385 0.358205 275.447 -0.720795 267.839 0.520205Z"/>
          </svg>
        </div>
        <h2 class="skills-heading">What I bring to<br/>the table</h2>
        <p class="skills-sub">Digital experiences designed to be built,<br class="hidden lg:inline"/> shipped, and used.</p>
      </div>

      {skills.map((s, i) => (
        <span class="skill-badge" data-i={i} data-x={s.x} data-y={s.y}>
          {s.label}
          <span class="xy-hint" id={`xy-${i}`}></span>
        </span>
      ))}

    </div>
  </div>

  <!-- Calibration HUD -->
  <div class="hud">
    <div class="hud-header">
      <span class="hud-title">Coordinates</span>
      <button class="hud-copy" id="copy-btn">Copy Array</button>
    </div>
    <div class="hud-list">
      {skills.map((s, i) => (
        <div class="hud-row" id={`hr-${i}`}>
          <span class="hud-name">{s.label}</span>
          <span class="hud-xy" id={`hv-${i}`}>x:{s.x.toFixed(2)} y:{s.y.toFixed(2)}</span>
        </div>
      ))}
    </div>
    <div class="hud-footer">
      <button class="hud-reset" id="reset-btn">Reset</button>
      <span class="copy-ok" id="copy-ok">Copied!</span>
    </div>
  </div>

  <script define:vars={{ skills }} is:inline>
    const orbit = document.getElementById('orbit');
    const state = skills.map(s => ({ ...s }));
    const badges = Array.from(document.querySelectorAll('.skill-badge'));

    const fmt = v => v.toFixed(2);

    function placeBadge(i) {
      const { x, y } = state[i];
      badges[i].style.left = `${x * orbit.offsetWidth}px`;
      badges[i].style.top  = `${y * orbit.offsetHeight}px`;
    }

    function updateDisplay(i) {
      const { x, y } = state[i];
      const xy = document.getElementById(`xy-${i}`);
      const hv = document.getElementById(`hv-${i}`);
      if (xy) xy.textContent = `${fmt(x)}, ${fmt(y)}`;
      if (hv) hv.textContent = `x:${fmt(x)} y:${fmt(y)}`;
    }

    function buildOutput() {
      return `[\n${state.map(s =>
        `  { label: '${s.label}', x: ${fmt(s.x)}, y: ${fmt(s.y)}, sr: ${s.sr}, sd: ${s.sd} },`
      ).join('\n')}\n]`;
    }

    function refreshAll() {
      state.forEach((_, i) => { placeBadge(i); updateDisplay(i); });
    }

    requestAnimationFrame(refreshAll);
    window.addEventListener('resize', refreshAll);

    function activate(i) {
      badges.forEach((el, idx) => el.classList.toggle('active', idx === i));
      document.querySelectorAll('.hud-row').forEach((el, idx) => el.classList.toggle('active', idx === i));
      document.getElementById(`hr-${i}`)?.scrollIntoView({ block: 'nearest' });
    }

    // Drag
    badges.forEach((el, i) => {
      el.addEventListener('pointerdown', e => {
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        el.classList.add('dragging');
        activate(i);
      });

      el.addEventListener('pointermove', e => {
        if (!el.hasPointerCapture(e.pointerId)) return;
        const r = orbit.getBoundingClientRect();
        state[i].x = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
        state[i].y = Math.max(0, Math.min(1, (e.clientY - r.top)  / r.height));
        placeBadge(i);
        updateDisplay(i);
      });

      const stop = () => el.classList.remove('dragging');
      el.addEventListener('pointerup', stop);
      el.addEventListener('pointercancel', stop);
    });

    // Reset
    document.getElementById('reset-btn').addEventListener('click', () => {
      skills.forEach((s, i) => { state[i].x = s.x; state[i].y = s.y; });
      refreshAll();
      badges.forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.hud-row').forEach(el => el.classList.remove('active'));
    });

    // Copy
    document.getElementById('copy-btn').addEventListener('click', () => {
      navigator.clipboard.writeText(buildOutput()).then(() => {
        const ok = document.getElementById('copy-ok');
        ok.classList.add('show');
        setTimeout(() => ok.classList.remove('show'), 2000);
      });
    });
  </script>

</body>
</html>
