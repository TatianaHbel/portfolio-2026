---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import CaseStudyBlockquote from '../../components/CaseStudyBlockquote.astro';
import { onePasswordSections } from '../../data/projects';
---

<ProjectLayout
  title="UX at a Web3 Startup | Tatiana Hernandez"
  description="UX at a Web3 Startup — Moralis 2022–2025"
  sections={onePasswordSections}
>
  <!-- Project header -->
  <div class="flex flex-col gap-8">
    <div class="flex flex-col gap-4">
      <h4>Moralis • Jan 2022 – May 2025</h4>
      <h1>UX at a Web3 Startup</h1>
    </div>

    <!-- Hero thumbnail -->
    <div class="w-full aspect-[16/9] border-1 border-foreground/10">
      <div class="relative w-full h-full overflow-hidden" role="img" aria-label="Project thumbnail for UX at a Web3 Startup">
        <img
          class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300"
          src="/moralis-developers-01.jpg"
          alt="Moralis Developers"
        />
      </div>
    </div>
  </div>

  <!-- Case study content -->
  <div class="flex flex-col gap-12 -mt-6 md:-mt-12">

    <!-- Overview + Rol + Timeline — divided layout -->
    <section id="overview" class="grid grid-cols-1 md:grid-cols-[2fr_2fr_auto] divide-y md:divide-y-0 md:divide-x divide-foreground/10">
      <!-- Col 1: Overview -->
      <div class="flex flex-col gap-2 pr-0 pb-6 md:pr-8 md:pb-0">
        <h4 class="!text-foreground">Overview</h4>
        <p>Moralis is a <strong class="font-semibold">Web3 infrastructure platform</strong> — APIs, nodes, and tooling for building decentralized applications. The challenge: make powerful, complex developer tooling feel approachable and trustworthy, especially for builders coming from Web2.</p>
      </div>

      <!-- Col 2: Rol -->
      <div class="flex flex-col gap-2 py-6 px-0 md:py-0 md:px-8">
        <h4 class="!text-foreground">Rol</h4>
        <p>As <strong class="font-semibold">Lead Product Designer</strong>, I owned the end-to-end design of the platform for over three years — combining <strong class="font-semibold">product strategy, UX/UI design, and cross-functional collaboration</strong> to lower entry barriers and bring Web2 developers into the Web3 ecosystem through familiar, well-crafted interfaces.</p>
      </div>

      <!-- Col 3: Timeline -->
      <div class="flex flex-col items-center justify-start gap-1 pt-6 pl-0 md:pt-0 md:pl-8 min-w-[100px]">
        <h4 class="!text-foreground">Timeline</h4>
        <p class="text-center">Jan 2022 –<br/>May 2025</p>
      </div>
    </section>

    <!-- Dashboard Redesign -->
    <section id="dashboard" class="flex flex-col gap-4">
      <h4 class="!text-foreground mb-1">Dashboard Redesign</h4>
      <h2 class="-mb-2">Turning a cluttered control panel into a developer's home base.</h2>
      <p>The dashboard was the first thing every Moralis developer saw after login — it needed to communicate value immediately without overwhelming. The old version failed on both fronts.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Before -->
        <div class="flex flex-col gap-4">
          <h4 class="!text-foreground">Before</h4>
          <div class="relative w-full overflow-hidden cursor-zoom-in" data-lightbox-trigger data-lightbox-index="0">
            <img
              class="w-full h-auto opacity-0 transition-opacity duration-300"
              src="/projects/1password/images/Before_01.png"
              alt="Dashboard before redesign — Moralis"
              data-lightbox-src="/projects/1password/images/Before_01.png"
              data-lightbox-alt="Dashboard before redesign — Moralis"
            />
          </div>
          <p>Key data — API keys, project details, support options — was buried in a cluttered layout with no hierarchy. Developers had to hunt for information on every visit. As the platform grew, fragmented patterns became friction — scaling the product without scaling confusion meant starting with the foundation.</p>
        </div>
        <!-- After -->
        <div class="flex flex-col gap-4">
          <h4 class="!text-foreground">After</h4>
          <div class="relative w-full overflow-hidden cursor-zoom-in" data-lightbox-trigger data-lightbox-index="1">
            <img
              class="w-full h-auto opacity-0 transition-opacity duration-300"
              src="/projects/1password/images/After_01.png"
              alt="Dashboard after redesign — Moralis"
              data-lightbox-src="/projects/1password/images/After_01.png"
              data-lightbox-alt="Dashboard after redesign — Moralis"
            />
          </div>
          <p>A modular layout organized around what developers look for first: usage vs. plan limits, API keys, project health, and a clear path to docs. Redesigning for modularity and consistency was foundational — scaling the product without scaling confusion. Result: <strong>+22% onboarding completion</strong>.</p>
        </div>
      </div>

      <CaseStudyBlockquote>A dashboard isn't a feature showcase — it's a status report. It should answer the developer's first question before they even ask it.</CaseStudyBlockquote>

      <!-- Before / After split slider -->
      <div class="flex flex-col gap-3 mt-4">
        <h4 class="!text-foreground">Side-by-side comparison</h4>
        <div
          id="split-container"
          class="relative w-full overflow-hidden select-none"
          style="cursor: ew-resize; aspect-ratio: 2880 / 2048;"
          aria-label="Before and after comparison slider"
        >
          <!-- Before (bottom layer, fills container) -->
          <img
            id="split-before-img"
            class="absolute inset-0 w-full h-full object-cover"
            src="/projects/1password/images/Before_01.png"
            alt="Dashboard before redesign"
            draggable="false"
          />

          <!-- After (top layer, clipped diagonally) -->
          <div
            id="split-after-panel"
            class="absolute inset-0 overflow-hidden"
          >
            <img
              id="split-after-img"
              class="absolute inset-0 h-full object-cover object-left"
              src="/projects/1password/images/After_01.png"
              alt="Dashboard after redesign"
              draggable="false"
            />
          </div>

          <!-- Edge masks: 12px inner frame so image corners are fully visible -->
          <div class="absolute top-0 inset-x-0 h-3 pointer-events-none z-10" style="background: var(--color-background);"></div>
          <div class="absolute bottom-0 inset-x-0 h-3 pointer-events-none z-10" style="background: var(--color-background);"></div>
          <div class="absolute inset-y-0 left-0 w-3 pointer-events-none z-10" style="background: var(--color-background);"></div>
          <div class="absolute inset-y-0 right-0 w-3 pointer-events-none z-10" style="background: var(--color-background);"></div>

          <!-- Diagonal divider line (SVG) -->
          <svg id="split-line-svg" class="absolute inset-0 w-full h-full pointer-events-none z-20" overflow="visible">
            <line
              id="split-line-el"
              x1="57.185%" y1="0%"
              x2="42.815%" y2="100%"
              stroke="rgba(255,255,255,0.85)"
              stroke-width="2"
              style="filter: drop-shadow(0 0 4px rgba(0,0,0,0.5));"
            />
          </svg>

          <!-- Handle -->
          <div
            id="split-handle"
            class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white shadow-lg flex items-center justify-center gap-[3px] pointer-events-none z-20"
            style="left: 50%;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:-10px;">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Streams -->
    <section id="streams" class="flex flex-col gap-4">
      <h4 class="!text-foreground mb-1">Streams</h4>
      <h2 class="-mb-2">Designing for real-time data — at any scale.</h2>
      <p>Moralis Streams lets developers monitor real-time wallet and smart contract events across multiple blockchains. Designing this surface meant working at the intersection of complex data, developer workflow, and trust — users needed to know their event listeners were working correctly, at a glance, without diving into logs.</p>

      <div class="flex flex-col gap-1 mt-2">
        <h3>Designing for builders, not users</h3>
        <p>Developers optimize for speed, trust, and control — not delight. Every product decision had to earn its place by reducing friction or increasing confidence in the platform.</p>
      </div>

      <div class="flex w-full flex-col md:flex-row gap-6 mt-2">
        <div class="flex flex-col gap-1 w-full">
          <h3>The challenge</h3>
          <p>Real-time event streams generate high-frequency data across multiple chains simultaneously. The UI needed to make that complexity manageable — not just display it. Developers needed to configure, monitor, and debug without getting lost in raw data.</p>
        </div>
        <div class="flex flex-col gap-1 w-full">
          <h3>What I designed</h3>
          <p>The full Streams interface: event configuration, customizable filtering, real-time activity monitoring, and status indicators that told developers instantly whether their streams were healthy and delivering events correctly.</p>
        </div>
        <div class="flex flex-col gap-1 w-full">
          <h3>The result</h3>
          <p>A developer tool that made monitoring blockchain events feel like monitoring any other API — familiar, reliable, and scannable. The design significantly reduced the learning curve for new users and enabled seamless integration of the Streams API into real applications.</p>
        </div>
      </div>

      <div class="relative w-full bg-foreground-light/10 animate-pulse overflow-hidden">
        <div class="w-full aspect-[16/9]" style="background-color:#1A316E20;"></div>
      </div>
    </section>

    <!-- More Work -->
    <section id="more-work" class="flex flex-col gap-4">
      <h4 class="!text-foreground mb-1">More Work</h4>
      <h2 class="-mb-2">Other surfaces I owned at Moralis.</h2>

      <h4 class="!text-foreground mt-8">Nodes</h4>
      <p>Designed the user flow and interface for Moralis Nodes — giving developers easy access to high-performance RPC nodes across major blockchain networks. The design emphasized reliability signals: uptime visibility, response time indicators, and security certifications (SOC 2 Type 2). For infrastructure products, trust isn't built through delight — it's built through transparency and consistency.</p>
      <div class="relative w-full bg-foreground-light/10 animate-pulse overflow-hidden">
        <div class="w-full aspect-[16/9]" style="background-color:#1A316E20;"></div>
      </div>

      <h4 class="!text-foreground mt-8">Account Abstraction & Swap Flows</h4>
      <p>Co-designed the Account Abstraction onboarding flow and owned end-to-end on-chain swap and asset transfer flows within Moralis Money — improving execution transparency and slippage clarity. Redesigned transaction confirmation states and feedback systems to reduce uncertainty during irreversible financial actions. The results were measurable: <strong>+30% wallet activation</strong> and a <strong>15% reduction in slippage-related support tickets within 3 months</strong>.</p>
      <div class="relative w-full bg-foreground-light/10 animate-pulse overflow-hidden">
        <div class="w-full aspect-[16/9]" style="background-color:#1A316E20;"></div>
      </div>

      <h4 class="!text-foreground mt-8">Payments & Checkout</h4>
      <p>Directed the redesign of the payment and checkout flow, including Payment Links, multiple payment method support, and a streamlined plan upgrade path. The focus was reducing conversion friction at the exact moment developers decide to invest in the platform — a high-stakes UX moment with a direct line to revenue. Simplified transaction flows improved overall payment completion and reduced checkout abandonment.</p>

      <div
        class="relative w-full overflow-hidden rounded-sm"
        data-scroll-reveal
      >
        <img
          class="w-full h-auto opacity-0 translate-y-5
                 transition-[opacity,transform] duration-700"
          style="transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);"
          src="/projects/1password/images/payments-checkout.png"
          alt="Payments and Checkout redesign — Moralis"
          data-reveal-img
        />

      </div>
    </section>

    <!-- Learnings -->
    <section id="learnings" class="flex flex-col gap-4">
      <h4 class="!text-foreground mb-1">Learnings</h4>
      <p>Three years designing developer tooling in the Web3 space taught me things that don't show up in any playbook. Here's what shaped how I think about product design.</p>

      <div class="flex w-full flex-col md:flex-row gap-6 mt-2">
        <div class="flex flex-col gap-1 w-full">
          <h3>Balancing innovation with usability.</h3>
          <p>Web3 offers opportunities for genuinely novel interactions, but novelty without usability is just friction. The most impactful design decisions at Moralis were the ones that made complex blockchain operations feel like standard developer tooling — not the ones that leaned into Web3's uniqueness for its own sake. Innovation earns its place only when it's accessible to the people it's meant for.</p>
        </div>
        <div class="flex flex-col gap-1 w-full">
          <h3>Bridging Web2 and Web3.</h3>
          <p>Most Moralis users came from a Web2 background. Designing for them meant building interfaces that were intuitive without erasing what made Web3 different — wallets, gas, smart contracts, chains. The goal wasn't to pretend those concepts didn't exist; it was to introduce them in context, when relevant, in language that developers already understood from their existing mental models.</p>
        </div>
        <div class="flex flex-col gap-1 w-full">
          <h3>User education as product design.</h3>
          <p>In a space as new as Web3, documentation and UI aren't separate concerns — they're the same surface. Every tooltip, empty state, and error message is a teaching moment. When users understand what's happening and why, they make better decisions, trust the platform more, and stay longer. Designing for comprehension is designing for retention.</p>
        </div>
      </div>

      <CaseStudyBlockquote>In Web3, confusion is a design problem. Every moment a developer doesn't understand what's happening is a moment they consider leaving.</CaseStudyBlockquote>
    </section>

  </div>
</ProjectLayout>

<!-- Lightbox overlay -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 opacity-0 pointer-events-none transition-opacity duration-300 p-4 md:p-10"
  role="dialog"
  aria-modal="true"
  aria-label="Image lightbox"
>
  <button
    id="lightbox-close"
    class="absolute top-4 right-5 text-white/70 hover:text-white text-3xl leading-none transition-colors z-10"
    aria-label="Close"
  >&times;</button>

  <!-- Prev arrow -->
  <button
    id="lightbox-prev"
    class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors p-2 z-10"
    aria-label="Previous image"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <img
    id="lightbox-img"
    class="max-w-full max-h-full object-contain rounded-sm shadow-2xl"
    src=""
    alt=""
  />

  <!-- Next arrow -->
  <button
    id="lightbox-next"
    class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors p-2 z-10"
    aria-label="Next image"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<script>
  // Lightbox with navigation
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement;
  const lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement;

  // Collect all lightbox-able images in DOM order
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]'));
  const images = triggers.map((t) => {
    const img = t.querySelector<HTMLImageElement>('[data-lightbox-src]');
    return { src: img?.dataset.lightboxSrc ?? '', alt: img?.dataset.lightboxAlt ?? '' };
  });

  let currentIndex = 0;

  function updateArrows() {
    lightboxPrev.style.opacity = images.length > 1 ? '1' : '0';
    lightboxNext.style.opacity = images.length > 1 ? '1' : '0';
    lightboxPrev.style.pointerEvents = images.length > 1 ? 'auto' : 'none';
    lightboxNext.style.pointerEvents = images.length > 1 ? 'auto' : 'none';
  }

  function openLightbox(index: number) {
    currentIndex = (index + images.length) % images.length;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
    updateArrows();
  }

  function closeLightbox() {
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  triggers.forEach((trigger, i) => {
    trigger.addEventListener('click', () => openLightbox(i));
  });

  lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(currentIndex - 1); });
  lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(currentIndex + 1); });
  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') openLightbox(currentIndex + 1);
  });

  // Before/After split slider
  const splitContainer = document.getElementById('split-container') as HTMLElement;
  const splitAfterPanel = document.getElementById('split-after-panel') as HTMLElement;
  const splitAfterImg = document.getElementById('split-after-img') as HTMLImageElement;
  const splitLineEl = document.getElementById('split-line-el') as unknown as SVGLineElement;
  const splitHandle = document.getElementById('split-handle') as HTMLElement;

  if (splitContainer) {
    let isDragging = false;
    const HALF_OFFSET = 7.185;

    function setSplit(clientX: number) {
      const rect = splitContainer.getBoundingClientRect();
      let center = (clientX - rect.left) / rect.width;
      center = Math.max(0, Math.min(1, center));

      const topX = center + HALF_OFFSET / 100;
      const bottomX = center - HALF_OFFSET / 100;

      splitAfterPanel.style.clipPath =
        `polygon(${topX * 100}% 0%, 100% 0%, 100% 100%, ${bottomX * 100}% 100%)`;
      splitAfterImg.style.width = `${rect.width}px`;

      splitLineEl.setAttribute('x1', `${topX * 100}%`);
      splitLineEl.setAttribute('x2', `${bottomX * 100}%`);
      splitHandle.style.left = `${center * 100}%`;
    }

    // Init
    const initTopX = 0.5 + HALF_OFFSET / 100;
    const initBottomX = 0.5 - HALF_OFFSET / 100;
    splitAfterPanel.style.clipPath =
      `polygon(${initTopX * 100}% 0%, 100% 0%, 100% 100%, ${initBottomX * 100}% 100%)`;
    splitAfterImg.style.width = `${splitContainer.getBoundingClientRect().width}px`;

    splitContainer.addEventListener('mousedown', (e) => { isDragging = true; setSplit(e.clientX); });
    window.addEventListener('mousemove', (e) => { if (isDragging) setSplit(e.clientX); });
    window.addEventListener('mouseup', () => { isDragging = false; });

    splitContainer.addEventListener('touchstart', (e) => { isDragging = true; setSplit(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('touchmove', (e) => { if (isDragging) setSplit(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('touchend', () => { isDragging = false; });
  }

  // Standard load reveal for non-scroll images
  document.querySelectorAll<HTMLImageElement>('img:not([data-reveal-img])').forEach((img) => {
    if (img.complete) {
      img.classList.remove('opacity-0');
    } else {
      img.addEventListener('load', () => img.classList.remove('opacity-0'));
    }
  });

  document.querySelectorAll<HTMLVideoElement>('video[data-inline-autoplay]').forEach((video) => {
    video.addEventListener('loadeddata', () => video.classList.remove('opacity-0'));
    if (video.readyState >= 3) video.classList.remove('opacity-0');
  });

  // Scroll-triggered reveal + activar micro-animaciones
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const img = entry.target.querySelector<HTMLImageElement>('[data-reveal-img]');
        if (!img) return;
        const trigger = () => {
          img.classList.remove('opacity-0', 'translate-y-5');
          revealObserver.unobserve(entry.target);
        };
        if (img.complete) trigger();
        else img.addEventListener('load', trigger, { once: true });
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('[data-scroll-reveal]').forEach((el) => revealObserver.observe(el));
</script>
