---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ShieldPay — Tatiana Hernandez"
  description="A UX case study for ShieldPay."
>
  <div id="iframe-wrapper" class="w-full">
    <iframe
      id="shieldpay-iframe"
      src="https://shieldpay-task.netlify.app/portfolio-preview"
      title="ShieldPay UX Case Study"
      style="width: 100%; border: none; display: block;"
      loading="eager"
    ></iframe>
  </div>
</BaseLayout>

<script>
  document.documentElement.classList.add('cursor-disabled');
  document.getElementById('custom-cursor')?.remove();
  document.querySelector('footer')?.remove();

  function fitIframe() {
    const header = document.getElementById('site-header');
    const iframe = document.getElementById('shieldpay-iframe') as HTMLIFrameElement;
    if (!iframe) return;
    const headerH = header?.offsetHeight ?? 64;
    iframe.style.height = `calc(100dvh - ${headerH}px)`;
  }

  fitIframe();
  window.addEventListener('resize', fitIframe);
</script>
