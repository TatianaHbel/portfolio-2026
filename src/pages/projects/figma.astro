<script>
  // ── Sidebar active section on scroll ──────────────────
  const sections = document.querySelectorAll<HTMLElement>('.ds-section');
  const navLinks = document.querySelectorAll<HTMLElement>('.ds-nav-link');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          navLinks.forEach(l => {
            l.classList.remove('active');
            l.removeAttribute('aria-current');
          });
          const link = document.querySelector<HTMLElement>(`.ds-nav-link[href="#${e.target.id}"]`);
          if (link) {
            link.classList.add('active');
            link.setAttribute('aria-current', 'true');
          }
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
  );
  sections.forEach(s => sectionObserver.observe(s));

  // ── Preview tab toggle ────────────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-preview-tabs').forEach(tabs => {
    tabs.querySelectorAll<HTMLElement>('.ds-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const panelId = tab.dataset.panel;
        if (!panelId) return;
        // Deactivate siblings
        tabs.querySelectorAll('.ds-tab').forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        // Show correct panel
        const block = tabs.closest<HTMLElement>('.ds-preview-block');
        if (!block) return;
        block.querySelectorAll<HTMLElement>('.ds-preview-canvas, .ds-code-panel').forEach(p => {
          p.style.display = p.id === panelId ? '' : 'none';
        });
      });
    });
  });

  // ── Copy buttons ──────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = btn.nextElementSibling?.textContent ?? '';
      navigator.clipboard.writeText(code.trim()).then(() => {
        btn.textContent = 'Copied ✓';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });
    });
  });

  // ── Button color palette tabs ─────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-btn-palette-tabs').forEach(paletteTabs => {
    paletteTabs.querySelectorAll<HTMLElement>('.ds-btn-palette-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const color = tab.dataset.color;
        if (!color) return;
        paletteTabs.querySelectorAll('.ds-btn-palette-tab').forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        const block = paletteTabs.closest<HTMLElement>('.ds-preview-block');
        if (!block) return;
        block.querySelectorAll<HTMLElement>('.ds-btn-color-panel').forEach(panel => {
          panel.style.display = panel.dataset.color === color ? '' : 'none';
        });
      });
    });
  });

  // ── Color swatch copy ─────────────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-swatch[data-copy]').forEach(swatch => {
    swatch.addEventListener('click', () => {
      const hex = swatch.dataset.copy ?? '';
      navigator.clipboard.writeText(hex).then(() => {
        const original = swatch.querySelector<HTMLElement>('.ds-swatch-hex');
        if (original) {
          const prev = original.textContent;
          original.textContent = 'Copied!';
          setTimeout(() => { original.textContent = prev; }, 1500);
        }
      });
    });
  });

  // ── Color set stop copy ────────────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-color-set-stop[data-copy]').forEach(stop => {
    stop.addEventListener('click', () => {
      const hex = stop.dataset.copy ?? '';
      navigator.clipboard.writeText(hex).then(() => {
        const hexEl = stop.querySelectorAll<HTMLElement>('.ds-mono')[1];
        if (hexEl) {
          const prev = hexEl.textContent;
          hexEl.textContent = 'Copied!';
          setTimeout(() => { hexEl.textContent = prev; }, 1500);
        }
      });
    });
  });

  // ── Download CSS ───────────────────────────────────────
  document.getElementById('ds-download-css')?.addEventListener('click', function() {
    const btn = this as HTMLButtonElement;
    const originalHTML = btn.innerHTML;
    btn.innerHTML = '<span class="ds-spinner" style="margin-right:8px"></span>Preparing…';
    btn.style.opacity = '0.75';
    btn.style.pointerEvents = 'none';
    setTimeout(() => {
      const styleEl = document.querySelector<HTMLStyleElement>('style');
      if (!styleEl) { btn.innerHTML = originalHTML; btn.style.opacity = ''; btn.style.pointerEvents = ''; return; }
      const css = styleEl.textContent ?? '';
      const blob = new Blob([css], { type: 'text/css' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'tatiana-design-system.css';
      a.click();
      URL.revokeObjectURL(url);
      btn.innerHTML = '✓ Downloaded';
      btn.style.opacity = '';
      setTimeout(() => { btn.innerHTML = originalHTML; btn.style.pointerEvents = ''; }, 2200);
    }, 500);
  });

  // ── Section scroll reveal ──────────────────────────────
  const dsRevealEls = document.querySelectorAll<HTMLElement>(
    '.ds-section-label-row, .ds-section-desc, .ds-subsection, .ds-overview-grid'
  );
  const dsRevealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('ds-reveal-visible');
          dsRevealObserver.unobserve(e.target);
        }
      });
    },
    { rootMargin: '0px 0px -40px 0px', threshold: 0.04 }
  );
  dsRevealEls.forEach((el, i) => {
    el.classList.add('ds-reveal');
    dsRevealObserver.observe(el);
  });

  // ── Stats count-up animation ──────────────────────────
  const countEls = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const countObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = parseInt(el.dataset.countTo ?? '0', 10);
        const duration = 900;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const ease = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(ease * target));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        countObserver.unobserve(el);
      });
    },
    { threshold: 0.5 }
  );
  countEls.forEach(el => countObserver.observe(el));

  // ── Scroll progress bar ────────────────────────────────
  const dsMainEl = document.querySelector<HTMLElement>('.ds-main');
  const dsProgressEl = document.getElementById('ds-progress');
  if (dsMainEl && dsProgressEl) {
    const updateProgress = () => {
      const { scrollTop, scrollHeight, clientHeight } = dsMainEl;
      const pct = scrollHeight <= clientHeight ? 0 : scrollTop / (scrollHeight - clientHeight);
      dsProgressEl.style.transform = `scaleX(${Math.min(pct, 1).toFixed(4)})`;
    };
    dsMainEl.addEventListener('scroll', updateProgress, { passive: true });
  }

  // ── Swatch copy pop feedback ──────────────────────────
  document.querySelectorAll<HTMLElement>('.ds-swatch[data-copy]').forEach(swatch => {
    swatch.addEventListener('click', () => {
      swatch.classList.remove('ds-just-copied');
      void swatch.offsetWidth;
      swatch.classList.add('ds-just-copied');
      swatch.addEventListener('animationend', () => swatch.classList.remove('ds-just-copied'), { once: true });
    });
  });
</script>
