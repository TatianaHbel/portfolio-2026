<style>
  /* ── Design System tokens ─────────────────────────── */
  .ds-root {
    /* Base palette */
    --ds-coral:      #DA6D5B;
    --ds-peach:      #ED7752;
    --ds-peach-deep: #C95E38;
    --ds-blush:      #F0A891;
    --ds-golden:     #E6B83A;
    --ds-cyan:       #0094BA;
    --ds-sage:       #8FA63C;

    /* Legacy aliases (keeps component demos working) */
    --ds-navy:       #2E3141;
    --ds-carmine:    #DA6D5B;
    --ds-pink:       #DA6D5B;
    --ds-light-pink: #ED7752;
    --ds-lime:       #E6B83A;
    --ds-red:        #DA6D5B;
    --ds-red-deep:   #C45A49;
    --ds-coral-deep: #C45A49;
    --ds-olive:      #8FA63C;

    /* Secondary palette — scales */
    --ds-rose-100:   #FDEDF2;
    --ds-rose-500:   #ED527A;
    --ds-rose-700:   #B23E5C;

    --ds-sky-100:    #EBF9FD;
    --ds-sky-500:    #52C8ED;
    --ds-sky-700:    #1E7F9B;

    --ds-lime-100:   #F2F5D3;
    --ds-lime-500:   #ABBA2B;
    --ds-lime-700:   #5F6814;

    --ds-yellow-100: #FEFBCF;
    --ds-yellow-500: #F8E816;
    --ds-yellow-700: #9C9007;

    /* Semantic */
    --ds-bg:           #FAF8F5;
    --ds-surface:      #FFFFFF;
    --ds-surface-2:    #F0EDE8;
    --ds-text:         #2E3141;
    --ds-text-muted:   #8B8796;
    --ds-accent:       #ED7752;
    --ds-accent-2:     #0094BA;
    --ds-accent-rose:  #ED527A;
    --ds-accent-sky:   #52C8ED;
    --ds-accent-lime:  #ABBA2B;
    --ds-accent-yellow:#F8E816;
    --ds-border:       rgba(46,49,65,0.10);

    /* Typography */
    --ds-font-display: "tiemposText", serif;
    --ds-font-ui:      "Geist", "Geist Fallback", sans-serif;
    --ds-font-mono:    "Geist Mono", "Geist Mono Fallback", monospace;

    /* Shadows */
    --ds-shadow-sm:        0 1px 4px rgba(46,49,65,0.08);
    --ds-shadow-md:        0 6px 24px rgba(46,49,65,0.12);
    --ds-shadow-glow-pink: 0 4px 20px rgba(218,109,91,0.22);
    --ds-shadow-glow-teal: 0 4px 20px rgba(0,148,186,0.25);

    --ds-ease:     cubic-bezier(0.16, 1, 0.3, 1);
    --ds-duration: 0.22s;

    /* Layout */
    display: flex;
    min-height: 100vh;
    background: var(--ds-bg);
    color: var(--ds-text);
    font-family: var(--ds-font-ui);
    position: relative;
  }

  /* ── Sidebar ──────────────────────────────────────── */
  .ds-sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--ds-border);
    background: var(--ds-surface);
    z-index: 10;
  }
  .ds-sidebar-inner {
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .ds-sidebar-brand {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--ds-text);
  }
  .ds-sidebar-title {
    font-family: var(--ds-font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--ds-text);
    margin-top: 4px;
    letter-spacing: -0.01em;
  }
  .ds-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }
  .ds-nav-link {
    font-family: var(--ds-font-ui);
    font-size: 13px;
    color: var(--ds-text-muted);
    text-decoration: none;
    padding: 9px 0 9px 16px;
    border-left: 2px solid transparent;
    transition: color var(--ds-duration) var(--ds-ease),
                border-color var(--ds-duration) var(--ds-ease);
  }
  .ds-nav-link:hover {
    color: var(--ds-text);
    border-left-color: var(--ds-border);
  }
  .ds-nav-link.active {
    color: var(--ds-accent);
    border-left-color: var(--ds-accent);
    border-left-width: 3px;
    padding-left: 15px;
    font-weight: 600;
    background: rgba(237, 119, 82, 0.07);
    border-radius: 0 6px 6px 0;
  }
  .ds-sidebar-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--ds-border);
    margin-top: 24px;
  }

  /* ── Main panel ───────────────────────────────────── */
  .ds-main {
    flex: 1;
    min-width: 0;
    padding: 64px 48px;
    overflow-y: auto;
    background: #FFFFFF;
  }
  @media (max-width: 768px) {
    .ds-sidebar { display: none; }
    .ds-main { padding: 40px 20px; }
  }

  /* ── Hero ─────────────────────────────────────────── */
  .ds-hero {
    margin-bottom: 96px;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--ds-border);
    max-width: 720px;
  }
  .ds-hero-title {
    font-family: var(--ds-font-display);
    font-size: clamp(56px, 8vw, 100px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ds-text);
    margin: 20px 0 24px;
  }
  .ds-hero-title em {
    background: linear-gradient(135deg, var(--ds-coral) 20%, var(--ds-accent-rose) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
  }
  .ds-hero-sub {
    font-size: 18px;
    color: var(--ds-text-muted);
    line-height: 1.65;
    max-width: 460px;
    margin-bottom: 32px;
  }
  .ds-hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ── Sections ─────────────────────────────────────── */
  .ds-section {
    margin-bottom: 112px;
    scroll-margin-top: 40px;
  }
  .ds-section-label-row {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 4px;
    border-top: 1px solid var(--ds-border);
    padding-top: 32px;
  }
  /* Section number — architectural element */
  .ds-section-label-row .ds-label {
    font-family: var(--ds-font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ds-text-muted);
    text-transform: uppercase;
    min-width: 48px;
  }
  .ds-section-title {
    font-family: var(--ds-font-display);
    font-size: clamp(36px, 4vw, 52px);
    color: var(--ds-text);
    letter-spacing: -0.025em;
    line-height: 1.0;
    padding: 8px 0 16px;
  }
  .ds-section-desc {
    color: var(--ds-text-muted);
    font-size: 16px;
    line-height: 1.65;
    margin-bottom: 48px;
    max-width: 500px;
  }
  .ds-subsection {
    margin-bottom: 56px;
  }
  .ds-subsection-title {
    font-size: 11px;
    font-family: var(--ds-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ds-text-muted);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ds-border);
  }

  /* ── Utility ──────────────────────────────────────── */
  .ds-mono    { font-family: var(--ds-font-mono); }
  .ds-muted   { color: var(--ds-text-muted); }
  .ds-label   { font-family: var(--ds-font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--ds-text-muted); }

  /* ── Badges ───────────────────────────────────────── */
  .ds-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 3px;
    font-family: var(--ds-font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    font-weight: 500;
    text-transform: uppercase;
  }
  .ds-badge-rose    { background: rgba(237,82,122,0.12);  color: var(--ds-rose-700); }
  .ds-badge-sky     { background: rgba(82,200,237,0.15);  color: var(--ds-sky-700); }
  .ds-badge-lime    { background: rgba(171,186,43,0.15);  color: var(--ds-lime-700); }
  .ds-badge-yellow  { background: rgba(248,232,22,0.2);   color: var(--ds-yellow-700); }
  .ds-badge-peach   { background: rgba(237,119,82,0.12);  color: var(--ds-peach-deep); }
  .ds-badge-neutral { background: rgba(46,49,65,0.07);    color: var(--ds-text-muted); }
  .ds-badge-outline { background: transparent; border: 1px solid var(--ds-border); color: var(--ds-text-muted); }
  /* Legacy aliases */
  .ds-badge-pink    { background: rgba(237,119,82,0.12);  color: var(--ds-peach-deep); }
  .ds-badge-teal    { background: rgba(82,200,237,0.15);  color: var(--ds-sky-700); }
  .ds-badge-carmine { background: rgba(237,82,122,0.12);  color: var(--ds-rose-700); }

  /* ── Buttons ──────────────────────────────────────── */
  .ds-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    font-family: var(--ds-font-ui);
    font-size: 14px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background-color var(--ds-duration) var(--ds-ease),
                color var(--ds-duration) var(--ds-ease),
                border-color var(--ds-duration) var(--ds-ease),
                transform var(--ds-duration) var(--ds-ease);
    border-radius: 3px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .ds-btn-sm { padding: 7px 14px; font-size: 12px; }
  .ds-btn-lg { padding: 15px 32px; font-size: 15px; }

  .ds-btn-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .ds-btn-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ds-btn-col-label {
    font-family: var(--ds-font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-text-muted);
  }
  .ds-btn-col-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .ds-btn-state {
    min-width: 88px;
    justify-content: center;
  }

  .ds-btn-primary {
    background: var(--ds-peach);
    color: #fff;
  }
  .ds-btn-primary:hover:not(:disabled) {
    background: var(--ds-peach-deep);
    transform: translateY(-1px);
  }
  .ds-btn-primary:active:not(:disabled) {
    transform: translateY(0);
  }
  .ds-btn-primary:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ds-btn-secondary {
    background: var(--ds-surface);
    color: var(--ds-text);
    border: 1px solid var(--ds-border);
  }
  .ds-btn-secondary:hover:not(:disabled) {
    background: var(--ds-surface-2);
    border-color: rgba(47,47,47,0.25);
  }

  .ds-btn-ghost {
    background: transparent;
    color: var(--ds-accent);
    border: 1px solid rgba(237,119,82,0.35);
  }
  .ds-btn-ghost:hover:not(:disabled) {
    background: rgba(237,119,82,0.07);
    border-color: var(--ds-accent);
  }

  .ds-btn-destructive {
    background: var(--ds-coral-deep);
    color: #fff;
  }
  .ds-btn-destructive:hover:not(:disabled) {
    background: #9A3D2A;
  }

  .ds-btn-loading {
    pointer-events: none;
    opacity: 0.65;
  }

  /* ── Palette tab selector ──────────────────────────── */
  .ds-btn-palette-tabs {
    display: flex;
    gap: 0;
    padding: 0 4px;
    background: var(--ds-surface-2);
    border-bottom: 1px solid var(--ds-border);
    overflow-x: auto;
  }
  .ds-btn-palette-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 16px;
    font-family: var(--ds-font-ui);
    font-size: 12px;
    font-weight: 500;
    color: var(--ds-text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--ds-duration) var(--ds-ease),
                border-color var(--ds-duration) var(--ds-ease);
  }
  .ds-btn-palette-tab:hover { color: var(--ds-text); }
  .ds-btn-palette-tab.is-active {
    color: var(--ds-text);
    border-bottom-color: var(--tab-color, var(--ds-accent));
  }
  .ds-btn-palette-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Secondary color buttons ───────────────────────── */
  /* Rose */
  .ds-btn-rose { background: var(--ds-rose-500); color: #fff; }
  .ds-btn-rose:hover:not(:disabled) { background: var(--ds-rose-700); transform: translateY(-1px); }
  .ds-btn-rose:active:not(:disabled) { transform: translateY(0); }
  .ds-btn-rose:disabled { opacity: 0.35; cursor: not-allowed; }

  .ds-btn-rose-outline { background: transparent; color: var(--ds-rose-500); border: 1px solid var(--ds-rose-500); }
  .ds-btn-rose-outline:hover:not(:disabled) { background: var(--ds-rose-100); }

  .ds-btn-rose-ghost { background: transparent; color: var(--ds-rose-500); border: 1px solid rgba(237,82,122,0.3); }
  .ds-btn-rose-ghost:hover:not(:disabled) { background: var(--ds-rose-100); border-color: var(--ds-rose-500); }

  /* Sky */
  .ds-btn-sky { background: var(--ds-sky-500); color: #fff; }
  .ds-btn-sky:hover:not(:disabled) { background: var(--ds-sky-700); transform: translateY(-1px); }
  .ds-btn-sky:active:not(:disabled) { transform: translateY(0); }
  .ds-btn-sky:disabled { opacity: 0.35; cursor: not-allowed; }

  .ds-btn-sky-outline { background: transparent; color: var(--ds-sky-700); border: 1px solid var(--ds-sky-500); }
  .ds-btn-sky-outline:hover:not(:disabled) { background: var(--ds-sky-100); }

  .ds-btn-sky-ghost { background: transparent; color: var(--ds-sky-700); border: 1px solid rgba(82,200,237,0.35); }
  .ds-btn-sky-ghost:hover:not(:disabled) { background: var(--ds-sky-100); border-color: var(--ds-sky-500); }

  /* Lime */
  .ds-btn-lime { background: var(--ds-lime-500); color: #2E3141; }
  .ds-btn-lime:hover:not(:disabled) { background: var(--ds-lime-700); color: #fff; transform: translateY(-1px); }
  .ds-btn-lime:active:not(:disabled) { transform: translateY(0); }
  .ds-btn-lime:disabled { opacity: 0.35; cursor: not-allowed; }

  .ds-btn-lime-outline { background: transparent; color: var(--ds-lime-700); border: 1px solid var(--ds-lime-500); }
  .ds-btn-lime-outline:hover:not(:disabled) { background: var(--ds-lime-100); }

  .ds-btn-lime-ghost { background: transparent; color: var(--ds-lime-700); border: 1px solid rgba(171,186,43,0.4); }
  .ds-btn-lime-ghost:hover:not(:disabled) { background: var(--ds-lime-100); border-color: var(--ds-lime-500); }

  /* Yellow */
  .ds-btn-yellow { background: var(--ds-yellow-500); color: #2E3141; }
  .ds-btn-yellow:hover:not(:disabled) { background: var(--ds-yellow-700); color: #fff; transform: translateY(-1px); }
  .ds-btn-yellow:active:not(:disabled) { transform: translateY(0); }
  .ds-btn-yellow:disabled { opacity: 0.35; cursor: not-allowed; }

  .ds-btn-yellow-outline { background: transparent; color: var(--ds-yellow-700); border: 1px solid var(--ds-yellow-500); }
  .ds-btn-yellow-outline:hover:not(:disabled) { background: var(--ds-yellow-100); }

  .ds-btn-yellow-ghost { background: transparent; color: var(--ds-yellow-700); border: 1px solid rgba(248,232,22,0.5); }
  .ds-btn-yellow-ghost:hover:not(:disabled) { background: var(--ds-yellow-100); border-color: var(--ds-yellow-500); }

  .ds-btn-peach { background: var(--ds-peach); color: #fff; }
  .ds-btn-peach:hover:not(:disabled) { background: var(--ds-peach-deep); transform: translateY(-1px); }
  .ds-btn-peach:active:not(:disabled) { transform: translateY(0); }
  .ds-btn-peach:disabled { opacity: 0.35; cursor: not-allowed; }

  .ds-btn-peach-outline { background: transparent; color: var(--ds-peach-deep); border: 1px solid var(--ds-peach); }
  .ds-btn-peach-outline:hover:not(:disabled) { background: rgba(237,119,82,0.08); }

  .ds-btn-peach-ghost { background: transparent; color: var(--ds-peach-deep); border: 1px solid rgba(237,119,82,0.35); }
  .ds-btn-peach-ghost:hover:not(:disabled) { background: rgba(237,119,82,0.07); border-color: var(--ds-peach); }

  /* ── Inputs ───────────────────────────────────────── */
  .ds-input-group { display: flex; flex-direction: column; gap: 6px; }
  .ds-input-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ds-text);
  }
  .ds-input-label-error { color: var(--ds-red); }
  .ds-input {
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-bottom: 2px solid rgba(47,47,47,0.25);
    color: var(--ds-text);
    padding: 10px 14px;
    font-family: var(--ds-font-ui);
    font-size: 14px;
    border-radius: 3px;
    outline: none;
    transition: border-color var(--ds-duration) var(--ds-ease),
                box-shadow var(--ds-duration) var(--ds-ease);
    width: 100%;
  }
  .ds-input::placeholder { color: var(--ds-text-muted); opacity: 0.6; }
  .ds-input:focus {
    border-color: var(--ds-coral);
    border-bottom-color: var(--ds-coral);
    box-shadow: 0 0 0 3px rgba(218,109,91,0.15);
  }
  .ds-input:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .ds-input-error {
    border-color: rgba(196,90,73,0.4);
    border-bottom-color: var(--ds-red-deep);
  }
  .ds-input-error:focus {
    border-color: var(--ds-coral-deep);
    box-shadow: 0 0 0 3px rgba(196,90,73,0.15);
  }
  .ds-input-hint { font-size: 12px; color: var(--ds-text-muted); }
  .ds-input-error-msg { font-size: 12px; color: var(--ds-red); }

  /* ── Cards ────────────────────────────────────────── */
  .ds-card {
    background: var(--ds-surface);
    border: 1px solid var(--ds-border);
    border-radius: 4px;
    padding: 28px;
    transition: transform var(--ds-duration) var(--ds-ease),
                box-shadow var(--ds-duration) var(--ds-ease);
  }
  .ds-card:hover { transform: translateY(-3px); box-shadow: var(--ds-shadow-md); }
  .ds-card-tag { margin-bottom: 14px; }
  .ds-card-title {
    font-family: var(--ds-font-display);
    font-size: 22px;
    color: var(--ds-text);
    margin-bottom: 8px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .ds-card-body { font-size: 14px; color: var(--ds-text-muted); line-height: 1.65; }

  /* ── Preview blocks ───────────────────────────────── */
  .ds-preview-block {
    border: 1px solid var(--ds-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .ds-preview-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--ds-border);
    padding: 0;
    background: var(--ds-surface-2);
  }
  .ds-tab {
    background: none;
    border: none;
    color: var(--ds-text-muted);
    font-family: var(--ds-font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 11px 20px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--ds-duration), border-color var(--ds-duration);
  }
  .ds-tab:hover { color: var(--ds-text); }
  .ds-tab.is-active {
    color: var(--ds-accent);
    border-bottom-color: var(--ds-accent);
    background: var(--ds-surface);
  }
  .ds-preview-canvas {
    padding: 40px;
    background: var(--ds-surface);
  }
  .ds-preview-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .ds-cards-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .ds-cards-row { grid-template-columns: 1fr; }
  }
  .ds-code-panel {
    position: relative;
    background: #1A1A1A;
    padding: 28px 28px 28px 28px;
  }
  .ds-code {
    margin: 0;
    font-family: var(--ds-font-mono);
    font-size: 12px;
    color: #A8A49E;
    line-height: 1.75;
    overflow-x: auto;
    white-space: pre;
  }
  .ds-copy-btn {
    position: absolute;
    top: 14px; right: 14px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.45);
    font-family: var(--ds-font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 2px;
    cursor: pointer;
    transition: color var(--ds-duration), background var(--ds-duration);
  }
  .ds-copy-btn:hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.12); }
  .ds-copy-btn.copied { color: var(--ds-olive); border-color: rgba(143,166,60,0.35); }

  /* ── Foundations: Radius ─────────────────────────── */
  .ds-radius-grid {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .ds-radius-item { display: flex; flex-direction: column; gap: 8px; align-items: center; }
  .ds-radius-box {
    width: 64px; height: 64px;
    background: var(--ds-surface-2);
    border: 1px solid var(--ds-border);
  }

  /* ── Foundations: Shadows ────────────────────────── */
  .ds-shadow-grid {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
