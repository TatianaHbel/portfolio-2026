---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';

// Raw CSS source — bundled at build time so the Download CSS button
// can hand the visitor the *actual* files behind this page, not a
// copy that drifts away from production.
//
// Each partial under styles/ds/ owns a semantic slice of the system.
// Adding a new partial? Add the ?raw import here, then concatenate it
// in the bundle below — the file order matches global.css's chain.
import fontsCss      from '../../styles/fonts.css?raw';
import themeCss      from '../../styles/theme.css?raw';
import baseCss       from '../../styles/base.css?raw';
import componentsCss from '../../styles/components.css?raw';
import dsLayoutCss      from '../../styles/ds/_layout.css?raw';
import dsTypographyCss  from '../../styles/ds/_typography.css?raw';
import dsComponentsCss  from '../../styles/ds/_components.css?raw';
import dsPatternsCss    from '../../styles/ds/_patterns.css?raw';
import dsMotionCss      from '../../styles/ds/_motion.css?raw';
import dsFoundationsCss from '../../styles/ds/_foundations.css?raw';

const downloadHeader = `/* ──────────────────────────────────────────────────────────────
 * Tatiana Hernandez — Personal Brand Design System
 * v1.0 · ${new Date().toISOString().slice(0, 10)}
 *
 * This file is the *actual* source behind the design-system page —
 * the same CSS that ships on every page of the portfolio. Source
 * lives modular; this download is the build-time concatenation.
 *
 * Source files (mirrored 1:1 in the sections below):
 *   src/styles/fonts.css         — @font-face declarations
 *   src/styles/theme.css         — design tokens (Tailwind @theme + --ds-*)
 *   src/styles/base.css          — element-level styles (h1, body, a)
 *   src/styles/components.css    — site primitives (cursor, project card)
 *   src/styles/ds/_layout.css        — page chrome
 *   src/styles/ds/_typography.css    — text utilities + type scale
 *   src/styles/ds/_components.css    — buttons, inputs, cards, badges
 *   src/styles/ds/_patterns.css      — preview blocks, swatches, navitems, before/after
 *   src/styles/ds/_motion.css        — easings, keyframes, hover, states
 *   src/styles/ds/_foundations.css   — radius, shadows, spacing, grid
 *
 * Dependencies
 *   • Tailwind CSS v4 (optional, recommended) — picks up the @theme
 *     block in theme.css so utility classes share the same tokens.
 *     Without Tailwind, the @theme block is a no-op; the rest works.
 *
 *   • Fonts — fonts.css references /fonts/*.woff2 and /fonts/*.otf:
 *       Geist + Geist Mono   → Vercel, MIT licensed (free to host)
 *           https://vercel.com/font
 *       Crimson Pro          → Google Fonts, OFL licensed (free to host)
 *           https://fonts.google.com/specimen/Crimson+Pro
 *       tiemposText          → Klim Type Foundry, COMMERCIAL license
 *           https://klim.co.nz/retail-fonts/tiempos-text/
 *           You must license and host this yourself; without it the
 *           CSS falls back to the "tiemposText Fallback" Arial-shim.
 *
 *     Place font files at /fonts/ (or rewrite the URLs in fonts.css).
 *
 * Drop-in usage
 *   @import "tailwindcss";        // optional
 *   @import "./tatiana-design-system.css";
 *
 * Then use any .ds-* class in your markup.
 * ──────────────────────────────────────────────────────────────── */

`;

const sectionHeader = (title: string) =>
  `\n\n/* ════════════════════════════════════════════════════════\n   ${title}\n   ──────────────────────────────────────────────────────── */\n`;

const downloadBundle = downloadHeader
  + sectionHeader('fonts.css — @font-face declarations')                + fontsCss
  + sectionHeader('theme.css — tokens (Tailwind @theme + --ds-*)')       + themeCss
  + sectionHeader('base.css — element-level styles')                     + baseCss
  + sectionHeader('components.css — site primitives')                    + componentsCss
  + sectionHeader('ds/_layout.css — page chrome')                        + dsLayoutCss
  + sectionHeader('ds/_typography.css — text utilities + type scale')    + dsTypographyCss
  + sectionHeader('ds/_components.css — buttons, inputs, cards, badges') + dsComponentsCss
  + sectionHeader('ds/_patterns.css — preview, swatches, nav, before/after') + dsPatternsCss
  + sectionHeader('ds/_motion.css — easings, keyframes, states')         + dsMotionCss
  + sectionHeader('ds/_foundations.css — radius, shadows, spacing, grid') + dsFoundationsCss;
---

<BaseLayout
  title="Personal Brand Guidelines — Tatiana Hernandez"
  description="A complete design system and visual language for Tatiana Hernandez — colors, typography, components, and interaction patterns."
>

<!-- ════════════════════════════════════════════════════════
     DESIGN SYSTEM ROOT — uses global ds-* classes from
     src/styles/design-system.css. No inline styles.
════════════════════════════════════════════════════════ -->
<div class="ds-root">

  <!-- Sidebar -->
  <aside class="ds-sidebar">
    <div class="ds-sidebar-inner">
      <div class="ds-sidebar-brand">
        <p class="ds-mono ds-muted">Design System</p>
        <p class="ds-sidebar-title">Personal Brand</p>
      </div>

      <nav class="ds-nav" aria-label="Design system sections">
        <a href="#overview"    class="ds-nav-link active">Overview</a>
        <a href="#colors"      class="ds-nav-link">Colors</a>
        <a href="#typography"  class="ds-nav-link">Typography</a>
        <a href="#iconos"      class="ds-nav-link">Icons</a>
        <a href="#buttons"     class="ds-nav-link">Components</a>
        <a href="#foundations" class="ds-nav-link">Foundations</a>
        <a href="#states"      class="ds-nav-link">Interaction States</a>
        <a href="#navigation"  class="ds-nav-link">Navigation</a>
        <a href="#cursor"      class="ds-nav-link">Cursor</a>
        <a href="#animations"  class="ds-nav-link">Animations</a>
        <a href="#spacing"     class="ds-nav-link">Grid &amp; Spacing</a>
      </nav>

      <div class="ds-sidebar-footer">
        <span class="ds-badge ds-badge-teal">v1.0</span>
        <span class="ds-mono ds-muted" style="font-size:10px">2025</span>
      </div>
    </div>
  </aside>

  <!-- Main panel -->
  <main class="ds-main">
    <div id="ds-progress" aria-hidden="true"></div>

    <!-- ── Hero ─────────────────────────────────────── -->
    <header class="ds-hero">
      <p class="ds-mono ds-muted ds-label ds-hero-enter">Tatiana Hernandez · Brand Identity</p>
      <h1 class="ds-hero-title ds-hero-enter">Personal Brand<br/><em>Guidelines</em></h1>
      <p class="ds-hero-sub ds-hero-enter">
        The design system behind this portfolio — documented as a live handoff artifact
        for developers.
      </p>
      <div class="ds-hero-badges ds-hero-enter">
        <span class="ds-badge ds-badge-pink">Design System</span>
        <span class="ds-badge ds-badge-outline">Web · Figma</span>
      </div>
    </header>

    <!-- ── Overview ──────────────────────────────────── -->
    <section id="overview" class="ds-section">
      <div class="ds-overview-grid">

        <div class="ds-overview-left">
          <h2 class="ds-overview-heading">
            Design doesn't end<br/>in Figma.
          </h2>
          <p class="ds-overview-body">
            This page <em>is</em> the design system. Every component here runs the exact
            same CSS as the rest of this portfolio — one file, one source of truth, no
            drift between documentation and production.
          </p>
          <p class="ds-overview-body">
            It's built as a handoff artifact: browse the catalog, copy snippets directly
            from the code panels, or download the full stylesheet and drop it into your
            own project.
          </p>
        </div>

        <div class="ds-overview-right">
          <div class="ds-overview-stats">
            <div class="ds-overview-stat">
              <span class="ds-overview-stat-value" data-count-to="10">0</span>
              <span class="ds-mono ds-muted ds-overview-stat-label">sections</span>
            </div>
            <div class="ds-overview-stat">
              <span class="ds-overview-stat-value" data-count-to="1">0</span>
              <span class="ds-mono ds-muted ds-overview-stat-label">source of truth</span>
            </div>
            <div class="ds-overview-stat">
              <span class="ds-overview-stat-value">v1.0</span>
              <span class="ds-mono ds-muted ds-overview-stat-label">current</span>
            </div>
          </div>
          <div class="ds-overview-actions">
            <button class="ds-btn ds-btn-primary" id="ds-download-css">
              Download CSS
            </button>
            <a href="#colors" class="ds-btn ds-btn-secondary" id="ds-browse-system">
              Browse system
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ── SECTION 1: Colors ──────────────────────── -->
    <section id="colors" class="ds-section">
      <div class="ds-section-label-row">
        <span class="ds-label ds-mono">01</span>
        <h2 class="ds-section-title">Colors</h2>
      </div>
      <p class="ds-section-desc">Two layers: a warm base for structure, and a personality palette that captures character.</p>

      <!-- Base palette -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Base Palette</h3>
        <div class="ds-swatch-grid ds-swatch-grid-3">
          {[
            { name: 'Coral', var: '--ds-coral', hex: '#DA6D5B', light: true  },
            { name: 'Peach', var: '--ds-peach', hex: '#ED7752', light: true  },
            { name: 'Blush', var: '--ds-blush', hex: '#F0A891', light: false },
          ].map(s => (
            <button
              class="ds-swatch"
              data-copy={s.hex}
              style={`background:${s.hex}`}
              aria-label={`Copy ${s.hex}`}
            >
              <span class="ds-swatch-info" style={`color:${s.light ? 'rgba(255,255,255,0.9)' : '#2E3141'}`}>
                <span class="ds-swatch-name">{s.name}</span>
                <span class="ds-mono ds-swatch-hex">{s.hex}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Secondary palette -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Secondary Palette</h3>
        <div class="ds-swatch-grid">
          {[
            { name: 'Rose',    hex: '#ED527A', light: true  },
            { name: 'Sky',     hex: '#52C8ED', light: false },
            { name: 'Lime',    hex: '#ABBA2B', light: false },
            { name: 'Yellow',  hex: '#F8E816', light: false },
            { name: 'Peach',   hex: '#ED7752', light: true  },
            { name: 'Rose 700',hex: '#B23E5C', light: true  },
          ].map(s => (
            <button
              class="ds-swatch"
              data-copy={s.hex}
              style={`background:${s.hex}`}
              aria-label={`Copy ${s.hex}`}
            >
              <span class="ds-swatch-info" style={`color:${s.light ? 'rgba(255,255,255,0.9)' : '#2E3141'}`}>
                <span class="ds-swatch-name">{s.name}</span>
                <span class="ds-mono ds-swatch-hex">{s.hex}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Semantic tokens -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Semantic Tokens</h3>
        <div class="ds-token-table">
          {[
            { token: '--ds-bg',           value: '#FAF8F5',             role: 'Page background'             },
            { token: '--ds-surface-2',    value: '#F0EDE8',             role: 'Elevated surface'            },
            { token: '--ds-text',         value: '#2E3141',             role: 'Primary text'                },
            { token: '--ds-text-muted',   value: '#8B8796',             role: 'Text muted'                  },
            { token: '--ds-border',       value: 'rgba(46,49,65,0.10)', role: 'Subtle border'               },
            { token: '--ds-accent',       value: '#ED7752',             role: 'Primary accent (Peach)'      },
            { token: '--ds-accent-rose',  value: '#ED527A',             role: 'Secondary accent — Rose'     },
            { token: '--ds-accent-sky',   value: '#52C8ED',             role: 'Secondary accent — Sky'      },
            { token: '--ds-accent-lime',  value: '#ABBA2B',             role: 'Secondary accent — Lime'     },
            { token: '--ds-accent-yellow',value: '#F8E816',             role: 'Secondary accent — Yellow'   },
          ].map(t => (
            <div class="ds-token-row">
              <div class="ds-token-swatch" style={`background:${t.value}`}></div>
              <code class="ds-mono" style="font-size:12px;color:var(--ds-accent)">{t.token}</code>
              <span class="ds-mono ds-muted" style="font-size:11px">{t.value}</span>
              <span class="ds-muted" style="font-size:13px">{t.role}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Color sets -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Color Sets</h3>
        <p class="ds-muted" style="font-size:13px;margin-bottom:20px">Three-stop scale per secondary color: light (100) · base (500) · dark (700).</p>
        <div class="ds-color-sets">
          {[
            {
              name: 'Rose',
              stops: [
                { label: '100', hex: '#FDEDF2', token: '--ds-rose-100', dark: false },
                { label: '500', hex: '#ED527A', token: '--ds-rose-500', dark: true  },
                { label: '700', hex: '#B23E5C', token: '--ds-rose-700', dark: true  },
              ]
            },
            {
              name: 'Sky',
              stops: [
                { label: '100', hex: '#EBF9FD', token: '--ds-sky-100',  dark: false },
                { label: '500', hex: '#52C8ED', token: '--ds-sky-500',  dark: false },
                { label: '700', hex: '#1E7F9B', token: '--ds-sky-700',  dark: true  },
              ]
            },
            {
              name: 'Lime',
              stops: [
                { label: '100', hex: '#F2F5D3', token: '--ds-lime-100', dark: false },
                { label: '500', hex: '#ABBA2B', token: '--ds-lime-500', dark: false },
                { label: '700', hex: '#5F6814', token: '--ds-lime-700', dark: true  },
              ]
            },
            {
              name: 'Yellow',
              stops: [
                { label: '100', hex: '#FEFBCF', token: '--ds-yellow-100', dark: false },
                { label: '500', hex: '#F8E816', token: '--ds-yellow-500', dark: false },
                { label: '700', hex: '#9C9007', token: '--ds-yellow-700', dark: true  },
              ]
            },
            {
              name: 'Peach',
              stops: [
                { label: '100', hex: '#FDEEE8', token: '--ds-peach-100', dark: false },
                { label: '500', hex: '#ED7752', token: '--ds-peach',     dark: true  },
                { label: '700', hex: '#C95E38', token: '--ds-peach-deep', dark: true  },
              ]
            },
          ].map(set => (
            <div class="ds-color-set">
              <p class="ds-mono ds-muted ds-color-set-name">{set.name}</p>
              <div class="ds-color-set-stops">
                {set.stops.map(stop => (
                  <button
                    class="ds-color-set-stop"
                    data-copy={stop.hex}
                    style={`background:${stop.hex}`}
                    aria-label={`Copy ${stop.hex}`}
                  >
                    <span class="ds-color-set-stop-info" style={`color:${stop.dark ? 'rgba(255,255,255,0.9)' : '#2E3141'}`}>
                      <span class="ds-mono" style="font-size:10px;opacity:0.7">{stop.label}</span>
                      <span class="ds-mono" style="font-size:11px;font-weight:500">{stop.hex}</span>
                      <span class="ds-mono" style={`font-size:9px;opacity:0.6`}>{stop.token}</span>
                    </span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Gradients -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Gradients</h3>
        <p class="ds-muted" style="font-size:13px;margin-bottom:20px">Named gradient tokens used across the system. Reference via CSS variable.</p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          {[
            {
              token: '--ds-gradient-brand',
              value: 'linear-gradient(135deg, #DA6D5B 20%, #ED527A 100%)',
              label: 'Brand — Coral → Rose',
              usage: 'Page loader, hero emphasis, primary gradient moments',
            },
          ].map(g => (
            <div style="display:grid;grid-template-columns:140px 1fr;gap:16px;align-items:center;padding:14px 16px;border:1px solid var(--ds-border);border-radius:8px;background:var(--ds-surface);">
              <div style={`background:${g.value};border-radius:6px;height:52px;`}></div>
              <div style="display:flex;flex-direction:column;gap:4px;">
                <code class="ds-mono" style="font-size:12px;color:var(--ds-accent)">{g.token}</code>
                <span class="ds-mono ds-muted" style="font-size:10px;">{g.value}</span>
                <span style="font-size:12px;color:var(--ds-text-muted);margin-top:2px;">{g.usage}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── SECTION 2: Typography ──────────────────── -->
    <section id="typography" class="ds-section">
      <div class="ds-section-label-row">
        <span class="ds-label ds-mono">02</span>
        <h2 class="ds-section-title">Typography</h2>
      </div>
      <p class="ds-section-desc">Two typefaces. One display, one functional. Never competing.</p>

      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Display — tiemposText</h3>
        <div class="ds-type-scale">
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Display / 64px</span>
            <p style="font-family:var(--ds-font-display);font-size:64px;line-height:1;letter-spacing:-0.03em;color:var(--ds-text)">Brand Identity</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">H1 / 48px</span>
            <p style="font-family:var(--ds-font-display);font-size:48px;line-height:1.05;letter-spacing:-0.02em;color:var(--ds-text)">Design Systems</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">H2 / 36px</span>
            <p style="font-family:var(--ds-font-display);font-size:36px;line-height:1.1;letter-spacing:-0.015em;color:var(--ds-text)">Visual Language</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">H3 / 24px</span>
            <p style="font-family:var(--ds-font-display);font-size:24px;line-height:1.2;color:var(--ds-text)">Component Patterns</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">H3 italic / 24px</span>
            <p style="font-family:var(--ds-font-display);font-size:24px;line-height:1.2;font-style:italic;color:var(--ds-accent-rose)">Interaction Design</p>
          </div>
        </div>
      </div>

      <div class="ds-subsection">
        <h3 class="ds-subsection-title">UI — Geist Sans</h3>
        <div class="ds-type-scale">
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Large / 18px</span>
            <p style="font-size:18px;color:var(--ds-text);line-height:1.6">A product designer who got tired of handing off files and started writing code.</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Body / 15px</span>
            <p style="font-size:15px;color:var(--ds-text-muted);line-height:1.65">I've been designing since 2012 — across SaaS, fintech, and Web3. I'm drawn to complex systems that need to feel simple.</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Small / 13px</span>
            <p style="font-size:13px;color:var(--ds-text-muted);line-height:1.5">Caption text, helper text, metadata</p>
          </div>
        </div>
      </div>

      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Mono — Geist Mono</h3>
        <div class="ds-type-scale">
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Label / 11px</span>
            <p style="font-family:var(--ds-font-mono);font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:var(--ds-accent)">SECTION LABEL</p>
          </div>
          <div class="ds-type-row">
            <span class="ds-mono ds-muted ds-type-label">Code / 13px</span>
            <p style="font-family:var(--ds-font-mono);font-size:13px;color:var(--ds-accent-sky)">{"const palette = { coral: '#DA6D5B', rose: '#ED527A', sky: '#52C8ED' }"}</p>
          </div>
        </div>
      </div>

      <!-- Color accents in type -->
      <div class="ds-subsection">
        <h3 class="ds-subsection-title">Color Accents in Type</h3>
        <p class="ds-muted" style="font-size:13px;margin-bottom:20px">Each secondary color as a typographic accent — for labels, callouts, and highlights.</p>
        <div class="ds-type-scale">
          {[
            { label: 'Rose accent',   color: 'var(--ds-accent-rose)',   text: 'Product Design',  token: '--ds-accent-rose'   },
            { label: 'Sky accent',    color: 'var(--ds-accent-sky)',    text: 'Engineering',     token: '--ds-accent-sky'    },
            { label: 'Lime accent',   color: 'var(--ds-accent-lime)',   text: 'Brand Identity',  token: '--ds-accent-lime'   },
            { label: 'Yellow accent', color: 'var(--ds-accent-yellow)', text: 'Design Systems',  token: '--ds-accent-yellow' },
          ].map(a => (
            <div class="ds-type-row">
              <span class="ds-mono ds-muted ds-type-label" style="font-size:10px">{a.label}</span>
              <div style="display:flex;align-items:baseline;gap:16px">
                <p style={`font-family:var(--ds-font-display);font-size:22px;font-style:italic;color:${a.color}`}>{a.text}</p>
                <code class="ds-mono" style={`font-size:11px;color:${a.color};opacity:0.7`}>{a.token}</code>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── SECTION 3: Icons ─────────────────────── -->
    <section id="iconos" class="ds-section">
      <div class="ds-section-label-row">
        <span class="ds-label ds-mono">03</span>
        <h2 class="ds-section-title">Icons</h2>
      </div>
      <p class="ds-section-desc">Custom brand icons — organic shapes that carry personality. Always in <span class="ds-mono" style="color:var(--ds-accent)">#ED7752</span> (Peach).</p>

      <div class="ds-subsection">
        <div class="ds-icon-grid">

          <div class="ds-icon-card">
            <div class="ds-icon-preview">
              <img src="/icons/full-bloom.svg" alt="Full Bloom icon" class="ds-icon-img" />
            </div>
            <div class="ds-icon-meta">
              <span class="ds-icon-name">Full Bloom</span>
              <span class="ds-mono ds-muted ds-icon-file">full-bloom.svg</span>
            </div>
          </div>

          <div class="ds-icon-card">
            <div class="ds-icon-preview">
              <img src="/icons/tatis-heart.svg" alt="Tati's Heart icon" class="ds-icon-img" />
            </div>
            <div class="ds-icon-meta">
              <span class="ds-icon-name">Tati's Heart</span>
              <span class="ds-mono ds-muted ds-icon-file">tatis-heart.svg</span>
            </div>
          </div>

          <div class="ds-icon-card">
            <div class="ds-icon-preview">
              <img src="/icons/two-full-stars.svg" alt="Two Full Stars icon" class="ds-icon-img" />
