---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experienceTimeline } from '../data/timeline';

const heroPhotos = [
  'D2651FF8-AE93-4BDC-B3CF-88F17CEC9848.jpg',
  'IMG_0822.jpg',
  'IMG_2415.jpg',
  'IMG_2930.jpg',
  'IMG_3705.jpg',
  'IMG_7925.JPG',
  'IMG_8960.jpg',
  'IMG_9756.jpg',
  'Tatiana Portrait.jpg',
  'tati_01.JPG',
  'tati_02.jpg',
  'tati_03.jpg',
  'tati_04.jpg',
];

const heroPhotoPos: Record<string, string> = {
  'IMG_3705.jpg':         'center 25%',
  'IMG_7925.JPG':         'center 25%',
  'IMG_8960.jpg':         'center 25%',
  'Tatiana Portrait.jpg': 'center 25%',
  'tati_04.jpg':          'center 20%',
  'IMG_9756.jpg':         'center 20%',
  'tati_03.jpg':          'center top',
};

const skills = [
  { label: 'Product Design',        x: 0.47, y: 0.07, sr: -3,  sd: 0   },
  { label: 'Frontend Development',  x: 0.73, y: 0.11, sr:  5,  sd: 40  },
  { label: 'Design Systems',        x: 0.11, y: 0.20, sr:  9,  sd: 80  },
  { label: 'UX Research',           x: 0.05, y: 0.47, sr: -9,  sd: 120 },
  { label: 'User Interface Design', x: 0.84, y: 0.43, sr:  7,  sd: 60  },
  { label: 'Prototyping',           x: 0.12, y: 0.73, sr:  3,  sd: 100 },
  { label: 'Web3 · DeFi',           x: 0.80, y: 0.68, sr: -7,  sd: 20  },
  { label: 'Generative AI',         x: 0.41, y: 0.88, sr: -4,  sd: 140 },
  { label: 'Visual Design',         x: 0.65, y: 0.85, sr:  8,  sd: 160 },
  { label: 'Motion Design',         x: 0.19, y: 0.59, sr: -12, sd: 180 },
];
---

<BaseLayout title="About — Tatiana Hernandez" description="One of a kind product designer who vibecodes. Designing at the intersection of systems and people.">

  <!-- ═══════════════════════════════════════════
       SECTION 1 · HERO — Full-bleed polaroid portrait
  ═══════════════════════════════════════════ -->
  <section class="polaroid-portrait-section relative overflow-hidden">

    <!-- Slideshow: all photos stacked, JS crossfades every 5s -->
    <div id="hero-slideshow" class="absolute inset-0" aria-hidden="true">
      {heroPhotos.map((file, i) => (
        <img
          src={`/img/photos/${file}`}
          alt=""
          class="hero-slide absolute inset-0 w-full h-full object-cover"
          style={`object-position: ${heroPhotoPos[file] ?? 'center center'}; opacity: ${i === 0 ? 1 : 0}; transition: opacity 1.2s ease-in-out;`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>

    <!-- Overlay -->
    <div class="absolute inset-0 bg-foreground/40 pointer-events-none"></div>

    <!-- Text — bottom left -->
    <div class="absolute bottom-10 left-6 md:bottom-16 md:left-14 z-10">
      <!-- "One of a kind." above the role title -->
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-background/50 mb-4">
        Hola <span class="text-primary">·</span> Hello <span class="text-primary">·</span> Salut <span class="text-primary">·</span> Hallo
      </p>
      <div class="overflow-hidden mb-2">
        <h1 class="hero-h1-light">One of a</h1>
      </div>
      <div class="overflow-hidden mb-6">
        <h1 class="hero-h1-light italic">kind.</h1>
      </div>
      <h2 class="text-background leading-[1.1] mb-3 text-[clamp(1.4rem,3.5vw,2.2rem)]">
        Product Designer. <em>Vibecoder.</em>
      </h2>
    </div>

    <!-- Floating polaroid — right, syncs with slideshow -->
    <div class="portrait-polaroid absolute right-6 top-1/2 md:right-16 z-10"
         style="transform: translateY(-50%)">
      <div class="portrait-polaroid-image" id="hero-polaroid-wrap">
        {heroPhotos.map((file, i) => (
          <img
            src={`/img/photos/${file}`}
            alt="Tatiana Hernandez"
            class="hero-polaroid-slide absolute inset-0 w-full h-full object-cover"
            style={`object-position: ${heroPhotoPos[file] ?? 'center center'}; opacity: ${i === 0 ? 1 : 0}; transition: opacity 1.2s ease-in-out;`}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <div class="portrait-polaroid-chin">
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 right-6 md:right-16 z-10 opacity-35 flex flex-col items-center gap-2">
      <p class="font-mono text-[10px] uppercase tracking-widest text-background writing-vertical">scroll</p>
      <div class="w-px h-8 bg-background/40 animate-bounce-big"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 · SKILLS — What I bring to the table
  ═══════════════════════════════════════════ -->
  <section class="skills-table-section border-t border-foreground/8 overflow-hidden">
    <div class="skills-orbit" id="skills-cluster" aria-label="Skills">

      <!-- Center: icon + title + subtitle (always visible) -->
      <div class="skills-center">
        <div class="skills-icon" aria-hidden="true">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
          </svg>
        </div>
        <h2 class="skills-heading">What I bring to<br/>the table</h2>
        <p class="skills-sub">Digital experiences designed to be built,<br class="hidden lg:inline"/> shipped, and used.</p>
      </div>

      <!-- Mobile: badges in a simple flex-wrap below the title -->
      <div class="skills-mobile-wrap">
        {skills.map(s => <span class="skill-badge-mobile">{s.label}</span>)}
      </div>

      <!-- Desktop: orbit badges — JS sets left/top px from data-x/y, then WAAPI animates -->
      {skills.map(s => (
        <span
          class="skill-badge"
          data-x={s.x}
          data-y={s.y}
          data-sr={`${s.sr}deg`}
          data-sd={s.sd}
        >
          {s.label}
        </span>
      ))}

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 · ABOUT — Bio
  ═══════════════════════════════════════════ -->
  <section class="about-bio px-6 md:px-12 py-24 md:py-32 border-t border-foreground/8">
    <div class="max-w-[1800px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-6 items-start">

      <!-- Left: polaroid photo -->
      <div class="reveal-block flex md:justify-start">
        <div class="about-polaroid">
          <div class="about-polaroid-image bg-foreground/8">
            <img
              src="/img/photos/tati_02.jpg"
              alt="Tatiana Hernandez — portrait"
              class="w-full h-full object-cover opacity-0 transition-opacity duration-700"
              loading="lazy"
              onload="this.style.opacity='1'"
            />
          </div>
          <div class="about-polaroid-chin"></div>
        </div>
      </div>

      <!-- Right: bio text -->
      <div class="flex flex-col gap-8 pt-4">
        <div>
          <h4 class="!text-primary font-mono uppercase tracking-widest text-[11px] mb-4">about <span style="background: var(--ds-gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">me</span></h4>
          <div class="mb-8">
            <h2 class="leading-tight">I love to <em class="about-hover-word">create</em> and <em class="about-hover-word">try</em> new things.</h2>
          </div>
          <div class="flex flex-col gap-4 text-foreground/65 max-w-lg">
            <p class="reveal-block" style="--delay:0ms">I'm a product designer who got tired of handing off files and started writing code. Now I do both, and I can't imagine going back.</p>
            <p class="reveal-block" style="--delay:80ms">I've been designing since 2012 — across SaaS, fintech, and Web3. I'm drawn to complex systems that need to feel simple. I think good design is mostly about removing things.</p>
            <p class="reveal-block" style="--delay:160ms">Outside of work I make generative art and take photos on film.</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 reveal-block" style="--delay:220ms">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-foreground/10 text-[12px] font-mono text-foreground/55">
            <span class="w-1.5 h-1.5 bg-primary animate-heartbeat inline-block"></span>
            Available for work
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-foreground/10 text-[12px] font-mono text-foreground/55">
            Lead Product Designer @ Amadeus Protocol
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 · EXPERIENCE — 2 column
  ═══════════════════════════════════════════ -->
  <section class="about-experience px-6 md:px-12 py-24 md:py-32 border-t border-foreground/8">
    <div class="max-w-[1800px] mx-auto flex flex-col gap-8">

      <!-- Title -->
      <h4 class="!text-primary font-mono uppercase tracking-widest text-[11px] text-center w-full">experience</h4>

      <!-- Horizontal timeline -->
      {(() => {
        const entries = [...experienceTimeline].reverse();
        const n = entries.length;
        // line runs from center of first dot to center of last dot
        const offset = `${100 / (n * 2)}%`;
        return (
          <div class="relative flex overflow-x-auto gap-0 scrollbar-hide" style="scrollbar-width:none;-ms-overflow-style:none;">
            <!-- connector line: from center of first dot to center of last dot -->
            <!-- top = h-5(20px) + mt-2(8px) + half of h-3(6px) = 34px -->
            <div
              class="absolute h-px bg-foreground/15 z-0 pointer-events-none"
              style={`top:34px; left:${offset}; right:${offset};`}
            ></div>

            {entries.map((entry, i) => {
              const isLatest = i === n - 1;
              return (
                <div
                  class="reveal-block group/tl relative flex flex-col items-center flex-1 min-w-[200px]"
                  style={`--delay:${i * 80}ms`}
                >
                  <!-- year: fixed height, centered above dot -->
                  <p class={`h-5 font-mono uppercase tracking-wider text-center ${isLatest ? 'text-[12px] text-foreground/60' : 'text-[11px] text-foreground/30'}`}>
                    {entry.year}
                  </p>

                  <!-- dot: mt-2 so its center = 20+8+6 = 34px from top -->
                  <div class={`w-3 h-3 rounded-full z-10 shrink-0 mt-2 mb-4 transition-colors duration-200 ${isLatest
                    ? 'bg-foreground group-hover/tl:bg-primary'
                    : 'border border-foreground/35 bg-background group-hover/tl:bg-foreground/60 group-hover/tl:border-foreground'
                  }`}></div>

                  <!-- info: centered text -->
                  <div class="flex flex-col items-center text-center gap-0.5 px-2">
                    {entry.companyUrl ? (
                      <a
                        href={entry.companyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`font-medium hover:text-primary transition-colors duration-200 ${isLatest ? 'text-[15px] text-foreground' : 'text-[14px] text-foreground/70'}`}
                        data-cursor="site"
                        aria-label={`Visit ${entry.company} (opens in new tab)`}
                      >
                        {entry.company}
                      </a>
                    ) : (
                      <span class={`font-medium ${isLatest ? 'text-[15px] text-foreground' : 'text-[14px] text-foreground/70'}`}>{entry.company}</span>
                    )}
                    <span class={`font-mono text-foreground/40 ${isLatest ? 'text-[13px]' : 'text-[11px]'}`}>{entry.role}</span>
                    {entry.context && (
                      <p class={`italic mt-1 ${isLatest ? 'text-[13px] text-foreground/55' : 'text-[12px] text-foreground/35'}`}>{entry.context}</p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        );
      })()}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 5 · CONNECT
  ═══════════════════════════════════════════ -->
  <section class="connect-section px-6 md:px-12 py-24 md:py-40 border-t border-foreground/8">
    <div class="connect-inner mx-auto text-center">

      <!-- Monogram icon -->
      <div class="connect-monogram reveal-block mx-auto mb-10">
        <svg width="40" height="40" viewBox="0 0 351 350" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M267.839 0.520205C233.1 6.1852 194.47 41.9362 173.223 88.0852C170.691 93.5852 168.071 99.7732 167.402 101.835C166.732 103.898 165.834 105.585 165.407 105.585C164.98 105.585 161.33 100.123 157.297 93.4482C141.701 67.6332 126.333 51.4142 108.263 41.6982C64.9113 18.3882 27.6283 27.5692 9.23233 66.0852C-8.63167 103.488 -0.328674 154.972 32.0333 207.464C47.7003 232.875 67.7053 258.726 84.3643 275.085C89.9653 280.585 99.2763 290.485 105.056 297.085C120.719 314.972 133.749 326.262 151.566 337.387C176.316 352.84 189.097 353.169 209.216 338.873C240.057 316.958 302.071 235.971 327.359 184.585C336.825 165.349 340.462 154.251 345.991 127.741C352.102 98.4362 351.705 71.0232 344.866 50.0712C336.992 25.9492 320.94 9.71121 298.037 2.70021C290.385 0.358205 275.447 -0.720795 267.839 0.520205Z" fill="#F0EDE8"/>
        </svg>
      </div>

      <!-- Heading -->
      <h2 class="connect-heading reveal-block mb-4">Ready to build something<br/><em>amazing?</em></h2>

      <!-- Available badge + subtitle -->
      <div class="flex flex-col items-center gap-3 mb-12 reveal-block">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 border border-primary/30 text-[11px] font-mono text-primary">
          <span class="w-1.5 h-1.5 bg-primary animate-heartbeat inline-block"></span>
          Available For Work
        </span>
        <p class="text-foreground/50 text-[15px]">Come and say Hola!</p>
      </div>

      <!-- Contact rows -->
      <div class="connect-rows reveal-block mx-auto">
        <a
          href="mailto:tati.hbel@gmail.com"
          class="connect-row"
          data-cursor="email"
          aria-label="Send email to Tatiana"
        >
          <span class="connect-row-label">Email</span>
          <span class="connect-row-value">tati.hbel@gmail.com</span>
        </a>
        <a
          href="https://www.linkedin.com/in/tatianahernandezbel/"
          target="_blank"
          rel="noopener noreferrer"
          class="connect-row"
          data-cursor="pointer"
          aria-label="Tatiana on LinkedIn"
        >
          <span class="connect-row-label">LinkedIn</span>
          <span class="connect-row-value">linkedin.com/in/tatianahernandezbel</span>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<!-- ═══════════════════════════════════════════
     STYLES
═══════════════════════════════════════════ -->
<style>
  /* ── Hero: CSS animation (no JS needed, always visible) ──── */
  .hero-h1 {
    font-family: var(--font-tiempos-text);
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }

  /* Light version for dark hero background */
  .hero-h1-light {
    font-family: var(--font-tiempos-text);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }

  /* ══════════════════════════════════════════════════════════════
     SKILLS ORBIT SECTION
  ══════════════════════════════════════════════════════════════ */

  /* ── Shared pill style (mobile + desktop badges) ─────────── */
  .skill-badge,
  .skill-badge-mobile {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    background: rgba(237, 119, 82, 0.07);
    border: 1px solid rgba(237, 119, 82, 0.2);
    border-radius: 70px;
    font-family: var(--font-geist-sans);
    font-size: 14px;
    letter-spacing: 0.01em;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  /* ── Icon ───────────────────────────────── */
  .skills-icon {
    width: 104px;
    height: 104px;
    background: var(--color-primary);
    border-radius: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin: 0 auto 1.75rem;
  }

  /* ── Title ──────────────────────────────── */
  .skills-heading {
    font-family: var(--font-tiempos-text);
    font-style: italic;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-foreground);
    margin-bottom: 1.25rem;
    white-space: nowrap;
  }

  /* ── Subtitle ───────────────────────────── */
  .skills-sub {
    font-family: var(--font-geist-sans);
    font-size: clamp(0.875rem, 1.2vw, 1rem);
    color: var(--color-foreground);
    opacity: 0.5;
    line-height: 1.65;
  }

  /* ══════════════════════════════════════════
     MOBILE — stacked layout
  ══════════════════════════════════════════ */
  .skills-orbit   { padding: 5rem 1.5rem 4rem; }
  .skills-center  { text-align: center; margin-bottom: 2.5rem; }

  /* Mobile badge wrap */
  .skills-mobile-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Desktop orbit badges hidden on mobile */
  .skill-badge { display: none; }

  /* ══════════════════════════════════════════
     DESKTOP (lg+) — orbit layout
  ══════════════════════════════════════════ */
  @media (min-width: 1024px) {
    .skills-table-section { padding: 0; }

    /* Fixed-height block container — no flex, no ambiguity */
    .skills-orbit {
      position: relative;
      height: 680px;
      display: block;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0;
    }

    /* Center content pinned to middle */
    .skills-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      z-index: 2;
      pointer-events: none;
      margin-bottom: 0;
      max-width: 520px;
    }

    /* Mobile wrap hidden on desktop */
    .skills-mobile-wrap { display: none; }

    /* Orbit badges: JS sets left/top in px, WAAPI animates in */
    .skill-badge {
      display: inline-flex;
      position: absolute;
      /* left/top set by JS — no default needed */
      transform: translate(-50%, -50%);
      opacity: 0;
      will-change: transform, opacity;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-badge-mobile { opacity: 1; }
    @media (min-width: 1024px) {
      .skill-badge { opacity: 1 !important; transform: translate(-50%, -50%) !important; }
    }
  }

  /* ── Cards floor section ─────────────────── */
  .cards-floor-inner {
    overflow: visible;
  }
  .cards-floor-inner .drag-card {
    position: absolute;
  }

  /* ── Scroll clip-path reveal ──────────────── */
  .clip-reveal {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .clip-reveal.visible {
    clip-path: inset(0 0% 0 0);
  }

  /* ── Connect section ────────────────────────── */
  .connect-inner {
    max-width: 640px;
  }

  .connect-heading {
    font-family: var(--font-tiempos-text);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }

  .connect-monogram {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background-color: var(--ds-peach);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .connect-monogram-text {
    font-family: var(--font-tiempos-text);
    font-size: 2rem;
    font-style: italic;
    color: var(--color-background);
    line-height: 1;
  }

  .connect-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 560px;
  }

  .connect-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    background-color: var(--ds-surface-2);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color var(--ds-duration) var(--ds-ease);
  }

  .connect-row:hover {
    background-color: color-mix(in srgb, var(--ds-peach) 10%, var(--ds-surface-2));
  }

  .connect-row-label {
    font-family: var(--font-geist-sans);
    font-size: 15px;
    color: var(--color-foreground);
  }

  .connect-row-value {
    font-family: var(--font-geist-mono);
    font-size: 13px;
    color: var(--color-foreground-light);
  }

  /* ── Primary button — interaction states ──── */
  .btn-primary {
    background-color: var(--ds-peach);
    color: var(--ds-navy);
    transition: background-color var(--ds-duration) var(--ds-ease),
                box-shadow var(--ds-duration) var(--ds-ease),
                transform var(--ds-duration) var(--ds-ease);
    outline: none;
  }
  .btn-primary:hover {
    background-color: var(--ds-peach-deep);
  }
  .btn-primary:active {
    background-color: var(--ds-coral-deep);
    transform: translateY(1px);
    box-shadow: none;
  }
  .btn-primary:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 3px;
    box-shadow: var(--ds-shadow-glow-pink);
  }

  /* ── Scroll opacity reveal ────────────────── */
  .reveal-block {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0ms);
  }
  .reveal-block.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ══════════════════════════════════════════════════════════════
     ICONIC POLAROID FORMAT
     Real Polaroid = white frame on all 4 sides.
     Thin border top + left + right (10–12px).
     Tall chin at bottom (~64–72px).
     Image area is square (aspect-ratio: 1).
  ══════════════════════════════════════════════════════════════ */

  /* ── Hero: full-bleed portrait section ────── */
  .polaroid-portrait-section {
    height: 85vh;
    min-height: 520px;
  }

  /* Sharpness boost for hero background images */
  .hero-slide {
    filter: contrast(1.08) saturate(1.1) brightness(1.02);
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    will-change: opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* Floating polaroid in hero */
  .portrait-polaroid {
    background: #fff;
    box-shadow: 0 24px 72px rgba(0,0,0,0.40), 0 4px 16px rgba(0,0,0,0.18);
    display: flex;
    flex-direction: column;
    width: 210px;
    padding: 10px 10px 0;       /* thin white border: top + sides */
  }
  @media (min-width: 768px) {
    .portrait-polaroid { width: 280px; padding: 12px 12px 0; }
  }
  .portrait-polaroid-image {
    width: 100%;
    aspect-ratio: 1;             /* square image area — pure Polaroid */
    overflow: hidden;
    position: relative;
  }
  .portrait-polaroid-chin {
    width: 100%;
    height: 60px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .portrait-polaroid-chin { height: 72px; }
