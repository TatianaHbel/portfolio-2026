    font-size: 15px;
    line-height: 1.35;
  }

  /* ── Vertical writing ─────────────────────── */
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  /* ── Reduced motion ──────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .clip-reveal { clip-path: none; transition: none; }
    .reveal-block { opacity: 1; transform: none; transition: none; }
    .polaroid-card { transition: none; }
  }
</style>

<!-- ═══════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════ -->
<script>
  // ── Hero slideshow — crossfade every 5s ───────────────────────
  const bgSlides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const polaroidSlides = Array.from(document.querySelectorAll<HTMLElement>('.hero-polaroid-slide'));
  let currentSlide = 0;

  if (bgSlides.length > 1) {
    setInterval(() => {
      bgSlides[currentSlide].style.opacity = '0';
      polaroidSlides[currentSlide].style.opacity = '0';
      currentSlide = (currentSlide + 1) % bgSlides.length;
      bgSlides[currentSlide].style.opacity = '1';
      polaroidSlides[currentSlide].style.opacity = '1';
    }, 5000);
  }

  // ── Skills cluster scatter-reveal ─────────────────────────────
  // ── Skills orbit — WAAPI scatter animation ────────────────────
  (() => {
    const orbit = document.getElementById('skills-cluster') as HTMLElement | null;
    if (!orbit) return;

    const skillsIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        skillsIO.unobserve(orbit);

        if (!window.matchMedia('(min-width: 1024px)').matches) return;

        const center = orbit.querySelector<HTMLElement>('.skills-center');
        const badges = Array.from(orbit.querySelectorAll<HTMLElement>('.skill-badge'));
        if (!center || !badges.length) return;

        // Step 1: set left/top in PIXELS from data-x/y fractions + actual orbit dimensions
        // Using offsetWidth/Height (no transforms, no viewport offset) for clean pixel math
        const ow = orbit.offsetWidth;
        const oh = orbit.offsetHeight;
        badges.forEach((badge) => {
          const x = parseFloat(badge.dataset.x ?? '0.5');
          const y = parseFloat(badge.dataset.y ?? '0.5');
          badge.style.left = `${x * ow}px`;
          badge.style.top  = `${y * oh}px`;
        });

        // Step 2: compute center of title block relative to orbit
        // getBoundingClientRect works now that orbit is in viewport
        const orbitRect = orbit.getBoundingClientRect();
        const cr        = center.getBoundingClientRect();
        const cx = (cr.left + cr.right)  / 2 - orbitRect.left;
        const cy = (cr.top  + cr.bottom) / 2 - orbitRect.top;

        // Step 3: WAAPI — each badge flies from center outward to its px position
        badges.forEach((badge) => {
          const r  = badge.getBoundingClientRect();
          const bx = (r.left + r.right)  / 2 - orbitRect.left;
          const by = (r.top  + r.bottom) / 2 - orbitRect.top;
          const dx = cx - bx;   // offset: badge_final → center
          const dy = cy - by;

          const sr = badge.dataset.sr ?? '0deg';
          const sd = parseInt(badge.dataset.sd ?? '0', 10);

          badge.animate(
            [
              {
                transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.5) rotate(${sr})`,
                opacity: '0',
              },
              {
                transform: 'translate(-50%, -50%) scale(1) rotate(0deg)',
                opacity: '1',
              },
            ],
            { duration: 750, delay: sd, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
          );
        });
      }),
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );

    skillsIO.observe(orbit);
  })();

  // ── Scroll reveals (clip-path + opacity) ──────────────────────
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    }),
    { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
  );
  document.querySelectorAll('.clip-reveal, .reveal-block').forEach((el) => io.observe(el));

  // ── Draggable cards — clean, no DOM-matrix reading ────────────
  // Each card stores rotation in data-rotation, initial offset in data-tx/data-ty.
  // JS tracks accumulated tx/ty per card — never reads from computed style.
  document.querySelectorAll<HTMLElement>('.drag-card').forEach((card) => {
    const rot = card.dataset.rotation ?? '0deg';
    let tx = parseFloat(card.dataset.tx ?? '0');
    let ty = parseFloat(card.dataset.ty ?? '0');
    let vx = 0, vy = 0;
    let startX = 0, startY = 0;
    let startTx = 0, startTy = 0;
    let prevX = 0, prevY = 0;
    let isDragging = false;
    let animFrame = 0;

    // Apply initial transform from data attributes
    card.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot})`;
    // translate-first so drag is always in screen space

    card.addEventListener('pointerdown', (e: PointerEvent) => {
      isDragging = true;
      cancelAnimationFrame(animFrame);
      card.setPointerCapture(e.pointerId);
      card.style.transition = 'none'; // CRITICAL: zero lag during drag
      card.style.zIndex = '10';
      startX = e.clientX;
      startY = e.clientY;
      startTx = tx;
      startTy = ty;
      prevX = e.clientX;
      prevY = e.clientY;
      vx = 0; vy = 0;
    });

    card.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;
      vx = e.clientX - prevX;
      vy = e.clientY - prevY;
      prevX = e.clientX;
      prevY = e.clientY;
      tx = startTx + (e.clientX - startX);
      ty = startTy + (e.clientY - startY);
      card.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot})`;
    });

    const onRelease = () => {
      if (!isDragging) return;
      isDragging = false;
      // Momentum: decay velocity, keep no CSS transition (all handled in rAF)
      const decay = () => {
        vx *= 0.85;
        vy *= 0.85;
        tx += vx;
        ty += vy;
        card.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot})`;
        if (Math.abs(vx) > 0.25 || Math.abs(vy) > 0.25) {
          animFrame = requestAnimationFrame(decay);
        }
      };
      animFrame = requestAnimationFrame(decay);
    };

    card.addEventListener('pointerup', onRelease);
    card.addEventListener('pointercancel', onRelease);
  });

  // ── Drag-to-scroll moments carousel ───────────────────────────
  const carousel = document.getElementById('moments-carousel') as HTMLElement | null;
  if (carousel) {
    let isDown = false;
    let startScrollX = 0;
    let startClientX = 0;
    carousel.addEventListener('pointerdown', (e: PointerEvent) => {
      isDown = true;
      carousel.setPointerCapture(e.pointerId);
      startScrollX = carousel.scrollLeft;
      startClientX = e.clientX;
    });
    carousel.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDown) return;
      carousel.scrollLeft = startScrollX - (e.clientX - startClientX);
    });
    const stopDrag = () => { isDown = false; };
    carousel.addEventListener('pointerup', stopDrag);
    carousel.addEventListener('pointercancel', stopDrag);
  }

  // ── Magnetic CTA button ────────────────────────────────────────
  const magneticBtn = document.querySelector<HTMLElement>('.magnetic-btn');
  if (magneticBtn) {
    magneticBtn.addEventListener('mousemove', (e: MouseEvent) => {
      const r = magneticBtn.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      if (Math.sqrt(dx * dx + dy * dy) < 80) {
        magneticBtn.style.transform = `translate(${dx * 0.35}px, ${dy * 0.35}px)`;
      }
    });
    magneticBtn.addEventListener('mouseleave', () => {
      magneticBtn.style.transition = 'transform 0.4s cubic-bezier(0.16,1,0.3,1), background-color 0.3s';
      magneticBtn.style.transform = 'translate(0,0)';
    });
    magneticBtn.addEventListener('mouseenter', () => {
      magneticBtn.style.transition = 'transform 0.1s ease, background-color 0.3s';
    });
  }
</script>
