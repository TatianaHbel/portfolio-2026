  /* ── About section polaroid ──────────────── */
  .about-polaroid {
    background: #fff;
    box-shadow: 0 10px 48px rgba(0,0,0,0.12), 0 2px 10px rgba(0,0,0,0.07);
    display: flex;
    flex-direction: column;
    width: 284px;
    flex-shrink: 0;
    padding: 12px 12px 0;        /* thin white border: top + sides */
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
  }
  .about-polaroid:hover {
    transform: rotate(2deg) translateY(-4px);
    box-shadow: 0 18px 56px rgba(0,0,0,0.15), 0 4px 14px rgba(0,0,0,0.09);
  }
  @media (min-width: 768px) {
    .about-polaroid { width: 400px; }
  }
  .about-polaroid-image {
    width: 100%;
    aspect-ratio: 1;             /* square image area */
    overflow: hidden;
  }
  .about-polaroid-chin {
    height: 68px;
    background: #fff;
  }

  /* ── About hover words ───────────────────── */
  .about-hover-word {
    font-style: italic;
    transition: -webkit-text-fill-color 0.2s ease;
  }
  .about-hover-word:hover {
    background: var(--ds-gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ── Moments carousel ────────────────────── */
  .moments-track {
    display: flex;
    gap: 20px;
    padding: 16px 24px 64px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
  }
  .moments-track:active { cursor: grabbing; }
  .moments-track::-webkit-scrollbar { display: none; }

  .moment-polaroid {
    scroll-snap-align: start;
    background: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.11), 0 2px 6px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    width: 190px;
    flex-shrink: 0;
    padding: 9px 9px 0;          /* thin white border: top + sides */
    transition: box-shadow 0.2s ease;
  }
  @media (min-width: 768px) {
    .moment-polaroid { width: 240px; padding: 11px 11px 0; }
  }
  .moment-polaroid:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
  }
  .moment-image {
    width: 100%;
    aspect-ratio: 1;             /* square image area */
    overflow: hidden;
  }
  .moment-chin {
    height: 52px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }
  @media (min-width: 768px) {
    .moment-chin { height: 60px; }
  }

  /* ── Polaroid label (shared italic text in chin) ── */
  .polaroid-label {
    font-family: var(--font-crimson-pro);
    font-style: italic;
    font-size: 13px;
    color: #888;
    letter-spacing: 0.01em;
  }

  /* ── Drag cards (photo card) ─────────────── */
  .polaroid-card {
    position: absolute;
    box-shadow: 0 8px 32px rgba(0,0,0,0.16), 0 2px 8px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    touch-action: none;
    user-select: none;
    cursor: grab;
    will-change: transform;
  }
  .polaroid-card:active { cursor: grabbing; }

  /* Photo drag card: iconic polaroid proportions */
  .polaroid-card.photo-card {
    background: #fff;
    padding: 9px 9px 0;
  }
  .polaroid-image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .polaroid-chin {
    flex-shrink: 0;
    height: 52px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Status cards: solid-color polaroid-shaped cards */
  .status-card {
    overflow: hidden;
  }
  .status-card-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
