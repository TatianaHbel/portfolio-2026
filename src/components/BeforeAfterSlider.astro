---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
  aspectRatio?: string;
  title?: string;
  class?: string;
}

const {
  beforeSrc,
  afterSrc,
  beforeAlt = 'Before',
  afterAlt = 'After',
  aspectRatio = '16 / 9',
  title,
  class: className,
} = Astro.props;
---

<div class:list={['flex flex-col gap-3', className]}>
  {title && <h4 class="!text-foreground">{title}</h4>}

  <div
    class="split-slider"
    style={`aspect-ratio: ${aspectRatio};`}
    aria-label="Before and after comparison slider"
  >
    <!-- Before (base layer) -->
    <img src={beforeSrc} alt={beforeAlt} draggable="false" />

    <!-- After (clipped layer) -->
    <div class="split-after-panel">
      <img src={afterSrc} alt={afterAlt} draggable="false" />
    </div>

    <!-- Vertical divider with drag handle -->
    <div class="split-divider" style="left: 50%;">
      <div class="split-handle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:-10px;">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.split-slider').forEach((container) => {
    const afterPanel = container.querySelector<HTMLElement>('.split-after-panel')!;
    const divider    = container.querySelector<HTMLElement>('.split-divider')!;
    let isDragging   = false;

    function setSplit(clientX: number) {
      const rect = container.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      afterPanel.style.clipPath = `polygon(${pct * 100}% 0%, 100% 0%, 100% 100%, ${pct * 100}% 100%)`;
      divider.style.left = `${pct * 100}%`;
    }

    container.addEventListener('mousedown', (e) => { isDragging = true; container.classList.add('dragging'); setSplit(e.clientX); });
    window.addEventListener('mousemove',    (e) => { if (isDragging) setSplit(e.clientX); });
    window.addEventListener('mouseup',      ()  => { isDragging = false; container.classList.remove('dragging'); });

    container.addEventListener('touchstart', (e) => { isDragging = true; container.classList.add('dragging'); setSplit(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('touchmove',     (e) => { if (isDragging) setSplit(e.touches[0].clientX); },   { passive: true });
    window.addEventListener('touchend',      ()  => { isDragging = false; container.classList.remove('dragging'); });
  });
</script>
